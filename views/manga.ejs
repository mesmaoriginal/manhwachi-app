        }


        // ===== دانلود چپتر برای خواندن آفلاین (فقط پرمیوم) =====
        function dlBtnHTML(num) {
            return '<button type="button" class="dl-btn" data-dl="${num}" data-state="idle" aria-label="دانلود چپتر ${num} برای خواندن آفلاین" title="دانلود برای خواندن آفلاین"><svg class="dl-svg" viewBox="0 0 44 44" aria-hidden="true"><circle class="dl-ring-bg" cx="22" cy="22" r="19"/><circle class="dl-ring" cx="22" cy="22" r="19"/><g class="dl-arrow"><path d="M22 11v15"/><path d="M15.5 20.5L22 27l6.5-6.5"/></g><path class="dl-tray" d="M14 33h16"/><path class="dl-check" d="M14.5 23l5.5 5.5 10-11.5"/></svg></button>'.replace(/\$\{num\}/g, String(num));
        }
        let __dlToastT = null;
        function dlToast(msg, ms) {
            let t = document.getElementById('dlToast');
            if (!t) { t = document.createElement('div'); t.id = 'dlToast'; t.className = 'dl-toast'; document.body.appendChild(t); }
            t.textContent = msg; t.classList.add('show');
            clearTimeout(__dlToastT); __dlToastT = setTimeout(() => t.classList.remove('show'), ms || 3200);
        }
        function showPremiumModal() { document.getElementById('premium-modal').classList.add('show'); }
        function hidePremiumModal() { document.getElementById('premium-modal').classList.remove('show'); }
        (function () {
            const m = document.getElementById('premium-modal');
            m.addEventListener('click', (e) => { if (e.target === m) hidePremiumModal(); });
            document.getElementById('pm-close').onclick = hidePremiumModal;
            document.getElementById('pm-later').onclick = hidePremiumModal;
            document.addEventListener('keydown', (e) => { if (e.key === 'Escape') hidePremiumModal(); });
        })();

        function dlOfflineOk() { return !!(window.MCOffline && MCOffline.supported()); }
        async function dlSession() {
            try {
                const r = await Promise.race([db.auth.getSession(), new Promise(res => setTimeout(() => res(null), 2500))]);
                const s = r && r.data && r.data.session;
                if (s && s.user) { if (window.MCOffline) MCOffline.rememberUid(s.user.id); return { uid: s.user.id, token: s.access_token }; }
            } catch (e) {}
            return null;
        }
        function setDl(btn, state, pct) {
            btn.dataset.state = state;
            const ring = btn.querySelector('.dl-ring');
            if (ring) ring.style.strokeDashoffset = String(119.4 * (1 - (pct || 0)));
            btn.title = state === 'done' ? 'ذخیره‌شده برای آفلاین (برای حذف بزنید)' : 'دانلود برای خواندن آفلاین';
        }
        async function refreshDlStates() {
            if (!dlOfflineOk()) return;
            const uid = (window.MCOffline.lastUid && MCOffline.lastUid()) || null;
            if (!uid) return;
            const btns = [...document.querySelectorAll('#episodeList .dl-btn')];
            for (const b of btns) {
                try { if (await MCOffline.has(uid, MANHWA_SLUG, Number(b.dataset.dl))) setDl(b, 'done', 1); } catch (e) {}
            }
        }
        async function handleDownload(btn) {
            const num = Number(btn.dataset.dl);
            if (btn.dataset.state === 'loading') return;
            if (btn.dataset.state === 'done') {
                const s = await dlSession();
                if (s && confirm('این چپتر از حافظه‌ی آفلاین حذف شود؟')) {
                    await MCOffline.remove(s.uid, MANHWA_SLUG, num);
                    setDl(btn, 'idle', 0);
                    dlToast('از حافظه‌ی آفلاین حذف شد', 2000);
                }
                return;
            }
            if (!navigator.onLine) { dlToast('برای دانلود باید آنلاین باشید'); return; }
            const sess = await dlSession();
            if (!sess || !sess.token) {
                dlToast('برای دانلود باید وارد حساب شوید');
                if (typeof openAuthModal === 'function') openAuthModal('login');
                return;
            }
            let acc = null;
            try {
                const r = await fetch('/api/access/me', { headers: { Authorization: 'Bearer ' + sess.token }, cache: 'no-store' });
                acc = r.ok ? await r.json() : null;
            } catch (e) {}
            if (acc && !acc.canOffline) { showPremiumModal(); return; }
            if (!dlOfflineOk()) { dlToast('مرورگر شما از دانلود آفلاین پشتیبانی نمی‌کند', 3800); return; }
            setDl(btn, 'loading', 0.04);
            try {
                await MCOffline.download({
                    slug: MANHWA_SLUG, ch: num, title: persianTitle || englishTitle || MANHWA_SLUG,
                    uid: sess.uid, accessToken: sess.token,
                    onProgress: (d, n) => setDl(btn, 'loading', Math.max(0.04, d / n))
                });
                setDl(btn, 'done', 1);
                dlToast('✅ چپتر ' + num + ' برای خواندن آفلاین ذخیره شد');
            } catch (e) {
                setDl(btn, 'idle', 0);
                dlToast(e.message || 'دانلود ناموفق بود', 4500);
            }
        }
        document.getElementById('episodeList').addEventListener('click', (e) => {
            const b = e.target.closest('.dl-btn');
            if (!b) return;
            e.preventDefault(); e.stopPropagation();
            handleDownload(b);
        });
        refreshDlStates();

        document.getElementById('episodeList').addEventListener('click', (e) => {
            if (e.target.closest('.dl-btn')) return; // دکمه‌ی دانلود جدا مدیریت می‌شود
            const card = e.target.closest('a[data-num]');

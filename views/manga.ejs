        <!-- Episodes List Section -->
        <section class="mx-sec">
            <div class="mx-head">
                <h3 class="section-title text-xl font-semibold">قسمت‌ها</h3>
                <button id="sortBtn" >جدیدترین اول <span class="material-symbols-outlined">swap_vert</span></button>
            </div>

            <div id="subscriptionBanner" class="mx-note <%= has_locked ? 'flex' : 'hidden' %>">
                <span class="material-symbols-outlined text-xl">workspace_premium</span>
                این مانهوا اشتراکی است
            </div>
            
            <div class="mx-list <%= episodes.length > 4 ? 'has-more' : '' %>" id="episodeWrap"><div class="mx-eps" id="episodeList">
                <%
                // تبدیل تاریخ شمسی (مثلا 1405/06/24) به میلادی برای محاسبه «جدید بودن» چپتر
                function ejsJalaliToGregorian(jy, jm, jd) {
                    var gy;
                    if (jy > 979) { gy = 1600; jy -= 979; } else { gy = 621; }
                    var days = (365 * jy) + (Math.floor(jy / 33) * 8) + (Math.floor(((jy % 33) + 3) / 4)) + 78 + jd + ((jm < 7) ? (jm - 1) * 31 : ((jm - 7) * 30) + 186);
                    gy += 400 * Math.floor(days / 146097);
                    days %= 146097;
                    if (days > 36524) {
                        days--;
                        gy += 100 * Math.floor(days / 36524);
                        days %= 36524;
                        if (days >= 365) days++;
                    }
                    gy += 4 * Math.floor(days / 1461);
                    days %= 1461;
                    if (days > 365) {
                        gy += Math.floor((days - 1) / 365);
                        days = (days - 1) % 365;
                    }
                    var gd = days + 1;
                    var isLeap = (gy % 4 === 0 && gy % 100 !== 0) || (gy % 400 === 0);
                    var sal_a = [0, 31, isLeap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
                    var gm;
                    for (gm = 0; gm < 13; gm++) {
                        var v = sal_a[gm];
                        if (gd <= v) break;
                        gd -= v;
                    }
                    return new Date(gy, gm - 1, gd);
                }
                function ejsIsEpisodeNew(ep) {
                    if (!ep || !ep.date) return false;
                    var parts = String(ep.date).split('/').map(Number);
                    if (parts.length !== 3 || parts.some(isNaN)) return false;
                    var gDate = ejsJalaliToGregorian(parts[0], parts[1], parts[2]);
                    var diffDays = (Date.now() - gDate.getTime()) / 86400000;
                    return diffDays >= 0 && diffDays < 2;
                }
                // رندر ۴ چپتر اول مستقیم در HTML برای خزش ربات گوگل
                var initial_episodes = episodes.slice().sort(function (a, b) { return Number(b.num) - Number(a.num); }).slice(0, 4);
                initial_episodes.forEach(function(ep) {
                    var ep_num = ep.num;
                    var is_free = !!ep.free;
                    var ep_link = "/reader.html?slug=" + encodeURIComponent(slug) + "&ch=" + ep_num;
                    var ep_is_new = ejsIsEpisodeNew(ep);
                %>
                <a href="<%= ep_link %>" data-free="<%= is_free ? '1' : '0' %>" data-num="<%= ep_num %>" class="mx-ep episode-card">
                    <div class="mx-thumb">
                        <img src="/manhwas/<%= encodeURIComponent(slug) %>/chapterPictures/chapterpicture<%= ep_num %>.png" class="chapter-cover-img" alt="Ep <%= ep_num %>" onerror="this.classList.add('hidden'); this.nextElementSibling.classList.remove('hidden');">
                        <div class="chapter-cover-fallback hidden">#<%= ep_num %></div>
                        <% if (!is_free) { %><div class="mx-lock chapter-lock-overlay"><span class="material-symbols-outlined">lock</span></div><% } %>
                        <% if (ep_is_new) { %><span class="new-badge">جدید</span><% } %>
                    </div>
                    <div class="mx-ep-b"><p class="mx-ep-t">چپتر <%= ep_num %></p><p class="mx-ep-d"><%= ep.date || '' %></p></div>
                    <span class="mx-st <%= is_free ? 'free' : 'paid' %>"><%= is_free ? 'رایگان' : 'اشتراکی' %></span>
                </a>
                <% }); %>
            </div></div>

            <button id="showMoreBtn" <%= episodes.length > 4 ? '' : 'hidden' %>><span id="showMoreText">نمایش قسمت‌های بیشتر</span><span class="material-symbols-outlined">expand_more</span></button>
        </section>

        <% if (manhwa && episodes.length) { %>
        <!-- 🔎 لینک داخلی قابل‌خزش به صفحه‌ی ایندکس‌شونده‌ی هر چپتر (/comic/<slug>/chapter-N) -->
        <section class="mx-sec mx-sec-sm" aria-label="فهرست چپترها">
            <details class="chapter-index">
                <summary>فهرست همه‌ی چپترهای مانهوا <%= title_fa || title_en %></summary>
                <nav>
                    <% episodes.slice().sort(function (a, b) { return Number(b.num) - Number(a.num); }).forEach(function (ep) { %>
                    <a href="/comic/<%= encodeURIComponent(slug) %>/chapter-<%= ep.num %>">چپتر <%= ep.num %></a>
                    <% }); %>
                </nav>
            </details>
        </section>
        <% } %>

        <!-- Similar Manhwas Section -->
        <section id="similarSection" class="mx-sec hidden">
            <div class="flex items-center justify-between mb-5">
                <h3 class="section-title text-xl font-semibold flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">auto_awesome</span>
                    مانهواهای مشابه
                </h3>
            </div>
            <div id="similarList" class="flex gap-4 overflow-x-auto pb-4 scrollbar-none snap-x"></div>
        </section>

        <% if (manhwa) { %>
        <%- include('partials/rating', { slug: slug }) %>
        <% } %>

        <div data-mhp="strip"></div>

        <!-- Comments Section -->
        <section id="commentsAnchor" class="mx-sec">
            <div class="flex items-center justify-between mb-6">
                <h3 class="section-title text-xl font-semibold">نظرات <span id="commentCount" class="text-on-surface-variant text-lg font-normal">(۰)</span></h3>
                <span class="text-sm text-text-muted">جدیدترین</span>
            </div>
            
            <div id="messagesList" class="space-y-6 mb-8"></div>
            
            <!-- Pagination Controls -->
            <div id="paginationContainer" class="flex justify-center items-center gap-2 mb-10 hidden">
                <button id="prevPageBtn" class="w-10 h-10 rounded-xl bg-surface-elevated border border-white/10 flex items-center justify-center text-on-surface disabled:opacity-40 disabled:pointer-events-none hover:border-primary/50 transition">
                    <span class="material-symbols-outlined text-xl">chevron_right</span>
                </button>
                <div id="pageNumbers" class="flex gap-2"></div>
                <button id="nextPageBtn" class="w-10 h-10 rounded-xl bg-surface-elevated border border-white/10 flex items-center justify-center text-on-surface disabled:opacity-40 disabled:pointer-events-none hover:border-primary/50 transition">
                    <span class="material-symbols-outlined text-xl">chevron_left</span>
                </button>
            </div>

            <div class="mx-form p-6">
                <div id="commentAuthorArea" class="mb-5"></div>
                <form id="messageForm" class="space-y-5">
                    <div>
                        <textarea id="messageText" maxlength="500" required rows="4" class="w-full bg-surface-container border border-white/10 focus:outline-none focus:ring-2 focus:ring-red-600 focus:border-red-600 rounded-3xl px-5 py-4 text-on-surface placeholder:text-on-surface-variant resize-none transition-all" placeholder="نظر خود را بنویسید..."></textarea>

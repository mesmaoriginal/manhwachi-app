<!DOCTYPE html>
<html class="dark" lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta name="robots" content="<%= manhwa ? 'index, follow, max-image-preview:large' : 'noindex, follow' %>">

    <!-- SEO Meta Tags -->
    <title><%= seo_title %></title>
    <meta name="description" content="<%= seo_desc %>">
    <link rel="canonical" href="<%= canonical_url %>" />

    <!-- Open Graph / Facebook / Telegram -->
    <meta property="og:type" content="article" />
    <meta property="og:locale" content="fa_IR" />
    <meta property="og:site_name" content="مانهواچی" />
    <meta property="og:title" content="<%= seo_title %>" />
    <meta property="og:description" content="<%= seo_desc %>" />
    <meta property="og:image" content="<%= full_cover_url %>" />
    <meta property="og:image:alt" content="<%= title_fa ? ('مانهوا ' + title_fa) : title_en %>" />
    <meta property="og:url" content="<%= canonical_url %>" />
    <% if (manhwa && typeof date_modified !== 'undefined' && date_modified) { %><meta property="article:modified_time" content="<%= date_modified %>" /><% } %>

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="<%= seo_title %>" />
    <meta name="twitter:description" content="<%= seo_desc %>" />
    <meta name="twitter:image" content="<%= full_cover_url %>" />
    <meta name="twitter:image:alt" content="<%= title_fa ? ('مانهوا ' + title_fa) : title_en %>" />
    <% if (manhwa) { %><link rel="preload" as="image" href="<%= cover_url %>" fetchpriority="high" /><% } %>

    <!-- Favicons -->
    <link rel="icon" href="/ManhwaChi/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/ManhwaChi/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/ManhwaChi/favicon-192x192.png" />
    <link rel="apple-touch-icon" href="/ManhwaChi/apple-touch-icon.png" />

    <!-- Google Structured Data (Schema.org) for SEO Rich Snippets -->
    <% if (manhwa) { %>
    <%
      var _gl = (typeof genre_links !== 'undefined' && genre_links.length) ? genre_links : genres.map(function(g){ return { name: g, slug: null }; });
      var _rd = (typeof release_date !== 'undefined' && release_date) ? String(release_date) : '';
      var _validDate = /^(19|20)\d{2}(-\d{2}){0,2}$/.test(_rd); // تاریخ شمسی (۱۴۰۳/..) در اسکیما نامعتبر است
      var _series = {
        "@type": "ComicSeries",
        "@id": canonical_url + "#series",
        "name": title_fa || title_en,
        "alternateName": (title_fa && title_en) ? title_en : undefined,
        "description": raw_desc || seo_desc,
        "image": full_cover_url,
        "url": canonical_url,
        "inLanguage": "fa",
        "genre": _gl.map(function(g){ return g.name; }),
        "datePublished": _validDate ? _rd : undefined,
        "dateModified": (typeof date_modified !== 'undefined' && date_modified) ? date_modified : undefined,
        "translator": scans_by ? { "@type": "Organization", "name": scans_by } : undefined,
        "publisher": { "@id": "https://manhwachi.ir/#org" },
        "isPartOf": { "@id": "https://manhwachi.ir/#website" },
        "mainEntityOfPage": { "@id": canonical_url + "#webpage" }
      };
      var _page = {
        "@type": "WebPage",
        "@id": canonical_url + "#webpage",
        "url": canonical_url,
        "name": seo_title,
        "description": seo_desc,
        "inLanguage": "fa-IR",
        "isPartOf": { "@id": "https://manhwachi.ir/#website" },
        "primaryImageOfPage": { "@type": "ImageObject", "url": full_cover_url },
        "breadcrumb": { "@id": canonical_url + "#breadcrumb" },
        "mainEntity": { "@id": canonical_url + "#series" },
        "dateModified": (typeof date_modified !== 'undefined' && date_modified) ? date_modified : undefined
      };
      var _crumbs = {
        "@type": "BreadcrumbList",
        "@id": canonical_url + "#breadcrumb",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "خانه", "item": "https://manhwachi.ir/" },
          { "@type": "ListItem", "position": 2, "name": "آرشیو مانهوا", "item": "https://manhwachi.ir/library-page.html" },
          { "@type": "ListItem", "position": 3, "name": title_fa || title_en, "item": canonical_url }
        ]
      };
    %>
    <script type="application/ld+json">
    <%- JSON.stringify({ "@context": "https://schema.org", "@graph": [_page, _series, _crumbs] }).replace(/</g, '\\u003c') %>
    </script>
    <% } %>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-18XD50KTY3"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-18XD50KTY3');
    </script>
    
    <link rel="stylesheet" href="/css/tailwind.css">
    <script>
      // اگر فایل کامپایل‌شده‌ی کامل Tailwind (با نشانه‌ی --mc-tw) نبود، مثل قبل از CDN لود می‌شود
      (function () {
        var ok = false;
        try { ok = !!getComputedStyle(document.documentElement).getPropertyValue('--mc-tw').trim(); } catch (e) {}
        window.__twLocal = ok;
        window.__twFallback = function (cb) {
          var s = document.createElement('script');
          s.src = 'https://cdn.tailwindcss.com?plugins=forms,container-queries';
          if (cb) s.onload = cb;
          document.head.appendChild(s);
        };
        
      })();
    </script>
    <link rel="stylesheet" href="/css/vendor/montserrat.css" onerror="this.onerror=null;this.media='print';this.onload=function(){this.media='all'};this.href='https://fonts.googleapis.com/css2?family=Montserrat:wght@400..800&amp;display=swap'">
    <link rel="stylesheet" href="/css/vendor/inter.css" onerror="this.onerror=null;this.media='print';this.onload=function(){this.media='all'};this.href='https://fonts.googleapis.com/css2?family=Inter:wght@400..700&amp;display=swap'">
    <link rel="stylesheet" href="/css/vendor/material-symbols.css" onerror="this.onerror=null;this.media='print';this.onload=function(){this.media='all'};this.href='https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=block'">
    <link rel="stylesheet" href="/css/vendor/vazirmatn.css" onerror="this.onerror=null;this.media='print';this.onload=function(){this.media='all'};this.href='https://fonts.googleapis.com/css2?family=Vazirmatn:wght@100..900&amp;display=swap'">
        <link rel="stylesheet" href="/css/vendor/fontawesome.css" onerror="this.onerror=null;this.media='print';this.onload=function(){this.media='all'};this.href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css'">
        <script id="tailwind-config">
        if (!window.__twLocal) window.__twFallback(function () {
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        primary: "#DC2626",
                        "on-primary": "#ffff",
                        surface: "#000000",
                        "surface-elevated": "#161616",
                        "surface-shadow":"#241717 ",
                        "surface-container": "#1f1f1f",
                        "on-surface": "#e2e2e2",
                        "on-surface-variant": "#cbb8b8",
                        "text-muted": "#8C8C8C",
                    }
                }
            }
        }
    });
    </script>

    <style>
        body { font-family: 'Vazirmatn', 'Inter', system-ui, sans-serif; font-weight: 400; -webkit-font-smoothing: antialiased; }
        /* سبک‌تر کردن وزن فونت‌ها تا با صفحه اصلی هماهنگ بشه */
        body .font-bold { font-weight: 600; }
        body .font-semibold { font-weight: 500; }
        .animate-fadeIn { animation: fadeIn 0.3s ease; }
        .glass-scrim {
            background: linear-gradient(to top, #000000 10%, rgba(0, 0, 0, 0.7) 50%, transparent 100%);
        }
        .text-shadow-glow {
            text-shadow: 0 0 20px rgb(220 38 38 / var(--tw-bg-opacity, 1));
        }
        .episode-card {
            transition: all 0.3s ease;
        }
        .episode-card:hover {
            transform: translateX(-10px);
            background-color: #2a2a2a;
        }
        .new-badge {
            position: absolute;
            top: 6px;
            right: 6px;
            z-index: 20;
            display: inline-flex;
            align-items: center;
            gap: 3px;
            padding: 2.5px 8px;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.3px;
            color: #fff;
            background: linear-gradient(135deg, #ff4d4d, #dc2626);
            border-radius: 999px;
            box-shadow: 0 0 10px rgba(220, 38, 38, 0.65), 0 2px 6px rgba(0,0,0,0.4);
            animation: newBadgePulse 1.8s ease-in-out infinite;
            pointer-events: none;
        }
        .new-badge::before {
            content: "";
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: #fff;
            box-shadow: 0 0 6px #fff;
        }
        @keyframes newBadgePulse {
            0%, 100% { box-shadow: 0 0 8px rgba(220, 38, 38, 0.55), 0 2px 6px rgba(0,0,0,0.4); transform: scale(1); }
            50% { box-shadow: 0 0 16px rgba(220, 38, 38, 0.95), 0 2px 6px rgba(0,0,0,0.4); transform: scale(1.06); }
        }
        @media (min-width: 1024px) {
            .text-shadow-glow { text-shadow: none; }
            .episode-card:hover { transform: translateY(-4px); background-color: #2a2a2a; }
        }
        .border-white {
            --tw-border-opacity: 1;
            border-color: rgb(255 255 255 / 27%);
        }
        .manhwa-card {
            position: relative;
            overflow: hidden;
        }
        .manhwa-card::before {
            content: "";
            position: absolute;
            width: 450px;
            height: 450px;
            background: #dc2626;
            opacity: 0.15;
            filter: blur(120px);
            top: -220px;
            left: 50%;
            transform: translateX(-50%);
            pointer-events: none;
        }
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #1f1f1f; }
        ::-webkit-scrollbar-thumb { background: rgb(220 38 38 / var(--tw-bg-opacity, 1)); border-radius: 10px; }

        .reply-box { margin-top:12px; padding:16px; background:#1f1f1f; border-radius:16px; border:1px solid rgba(255,255,255,0.08); }
        .reply-thread {
            border-right: 3px solid rgba(255, 255, 255, 0.08);
            margin-right: 8px;
            padding-right: 14px;
            background: rgba(255, 255, 255, 0.015);
            padding-top: 8px;
            padding-bottom: 8px;
            border-radius: 0 12px 12px 0;
            transition: all 0.2s ease;
        }
        .reply-thread:hover {
            border-right-color: rgba(220, 38, 38, 0.5);
            background: rgba(255, 255, 255, 0.03);
        }

        .admin-reply {
            background: linear-gradient(135deg, rgba(220, 38, 38, 0.08) 0%, rgba(0, 0, 0, 0.3) 100%);
            border: 1px solid rgba(220, 38, 38, 0.25);
            border-right: 3px solid #DC2626;
            border-radius: 16px;
            padding: 14px 16px;
            box-shadow: 0 4px 20px rgba(220, 38, 38, 0.05);
        }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .comment-animate { animation: fadeIn 0.5s cubic-bezier(0.4, 0, 0.2, 1); }


        #mobile-drawer { transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1); }
        #drawer-overlay { transition: opacity 0.3s ease, visibility 0.3s ease; }
        .drawer-open #mobile-drawer { transform: translateX(0) !important; }
        .drawer-open #drawer-overlay { opacity: 1 !important; visibility: visible !important; pointer-events: auto !important; }
        .drawer-item { transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1); }
        .drawer-item:hover {
            background: rgba(220, 38, 38, 0.12);
            border-color: rgba(220, 38, 38, 0.3);
            transform: translateX(-4px);
        }
        .nav-link { position: relative; }
        .nav-link::after {
            content: '';
            position: absolute;
            bottom: -4px;
            right: 0;
            width: 0;
            height: 2px;
            background-color: #DC2626;
            transition: width 0.3s ease;
        }
        .nav-link:hover::after { width: 100%; }

        .scrollbar-none::-webkit-scrollbar { display: none; }
        .scrollbar-none { -ms-overflow-style: none; scrollbar-width: none; }
        /* اندازه‌ی استاندارد متن‌های منوی کشویی */
        #mobileDrawer .drawer-item { font-size: 13.5px; padding: 11px 12px; gap: 11px; }
        #mobileDrawer .drawer-item .text-sm { font-size: 13.5px; }
        #mobileDrawer .drawer-item > div:first-child,
        #mobileDrawer .drawer-item .w-9 { width: 34px; height: 34px; }
        #mobileDrawer .drawer-item .material-symbols-outlined { font-size: 20px; }
        #mobileDrawer a[href*="telegram"] { padding: 12px 14px; }
        #mobileDrawer a[href*="telegram"] .text-sm { font-size: 13px; }
        #mobileDrawer a[href*="telegram"] .material-symbols-outlined.text-2xl { font-size: 22px; }

        /* ===== فهرست چپترها (لینک‌های قابل‌خزش) هماهنگ با کارت‌های سایت ===== */
        .chapter-index { border: 1px solid rgba(255,255,255,.08); border-radius: 20px; background: #161616; overflow: hidden; }
        .chapter-index summary { cursor: pointer; list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 18px; font-size: 14px; font-weight: 500; color: #e2e2e2; }
        .chapter-index summary::-webkit-details-marker { display: none; }
        .chapter-index summary::after { content: "expand_more"; font-family: 'Material Symbols Outlined'; font-size: 22px; color: #DC2626; transition: transform .25s ease; }
        .chapter-index[open] summary::after { transform: rotate(180deg); }
        .chapter-index nav { display: flex; flex-wrap: wrap; gap: 8px; padding: 0 18px 16px; max-height: 220px; overflow-y: auto; }
        .chapter-index nav a { padding: 5px 14px; border-radius: 999px; border: 1px solid rgba(255,255,255,.1); background: rgba(255,255,255,.04); font-size: 12px; color: #cbb8b8; transition: all .2s ease; }
        .chapter-index nav a:hover { color: #fff; border-color: rgba(220,38,38,.5); background: rgba(220,38,38,.12); }

        /* ===== نشان زمان‌باز‌شدن چپتر (جایگزین ایموجی 🔒) ===== */
        .lock-pill { display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; border-radius: 999px; background: rgba(245,158,11,.1); border: 1px solid rgba(245,158,11,.25); color: #fbbf24; font-size: 11.5px; font-weight: 500; white-space: nowrap; }
        .lock-pill .material-symbols-outlined { font-size: 15px; }


        /* ===================== طراحی مینیمال جدید ===================== */
        @property --fade { syntax: '<length>'; inherits: false; initial-value: 0px; }
        :root { --ln: rgba(255,255,255,.08); }
        main.manhwa-main { position: relative; isolation: isolate; }
        .mx-backdrop { position: absolute; z-index: -1; inset: -64px 0 auto 0; height: 640px; overflow: hidden; pointer-events: none;
            -webkit-mask-image: linear-gradient(#000 15%, transparent); mask-image: linear-gradient(#000 15%, transparent); }
        .mx-backdrop img { width: 100%; height: 100%; object-fit: cover; filter: blur(40px) saturate(1.3); opacity: .3; transform: scale(1.3); }
        .mx-hero { display: grid; grid-template-areas: "cover" "info"; gap: 26px; max-width: 72rem; margin: 0 auto; padding: 28px 20px 0; }
        .mx-cover { grid-area: cover; justify-self: center; width: min(58vw, 240px); aspect-ratio: 3/4; object-fit: cover; object-position: top;
            border-radius: 18px; border: 1px solid var(--ln); box-shadow: 0 28px 60px -26px #000; }
        .mx-info { grid-area: info; min-width: 0; text-align: center; }
        #type { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; margin-bottom: 14px; direction: rtl; }
        #type > * { padding: 4px 12px; border-radius: 99px; font-size: 12px; color: rgba(255,255,255,.72); border: 1px solid var(--ln); transition: .2s; }
        #type > span:first-child { color: #fecaca; background: rgba(220,38,38,.16); border-color: rgba(220,38,38,.3); }
        #type > a:hover { color: #fff; border-color: rgba(255,255,255,.3); }
        #manhwaTitle { font-size: clamp(28px, 6vw, 46px); font-weight: 600; line-height: 1.15; letter-spacing: -.02em; color: #fff; cursor: pointer; text-align: center; }
        #faSubtitle { margin-top: 8px; font-size: 14px; color: rgba(255,255,255,.55); }
        .mx-meta { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 6px 18px; margin-top: 16px; font-size: 13px; color: #9a9a9a; }
        .mx-meta > * { display: inline-flex; align-items: center; gap: 4px; }
        .mx-meta .material-symbols-outlined { font-size: 17px; }
        .mx-actions { display: flex; gap: 10px; margin: 22px auto 0; max-width: 420px; }
        #readBtn { flex: 1; height: 50px; border-radius: 14px; background: #dc2626; color: #fff; font-size: 15px; font-weight: 500; transition: transform .2s, background .2s; }
        #readBtn:hover { background: #ef4444; } #readBtn:active { transform: scale(.97); }
        .mx-icon { width: 50px; height: 50px; border-radius: 14px; border: 1px solid rgba(255,255,255,.14); color: #fff; background: rgba(255,255,255,.03); display: grid; place-items: center; transition: .2s; }
        .mx-icon:hover { border-color: rgba(255,255,255,.35); } .mx-icon:active { transform: scale(.95); }
        .mx-icon.is-on { background: #dc2626; border-color: #dc2626; }
        .mx-stats { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; margin-top: 26px; border-block: 1px solid var(--ln); }
        .mx-stat { padding: 14px 8px; text-align: center; } .mx-stat + .mx-stat { border-inline-start: 1px solid var(--ln); }
        .mx-stat small { display: block; font-size: 11.5px; color: #8c8c8c; margin-bottom: 4px; }
        .mx-stat b { font-size: 15px; font-weight: 500; color: #fff; }
        .mx-desc { margin-top: 22px; }
        .mx-desc-text { font-size: 15px; line-height: 1.95; color: #bdb3b3; text-align: start; max-height: calc(1.95em * 4); overflow: hidden; --fade: 0px;
            -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - var(--fade)), transparent); mask-image: linear-gradient(to bottom, #000 calc(100% - var(--fade)), transparent);
            transition: max-height .6s cubic-bezier(.4,0,.2,1), --fade .6s ease; }
        .mx-desc-text.is-clamped { --fade: 58px; } .mx-desc-text.expanded { --fade: 0px; }
        #descriptionToggleBtn { display: none; align-items: center; gap: 2px; margin: 6px auto 0; font-size: 13px; color: #9a9a9a; transition: color .2s; }
        #descriptionToggleBtn.show { display: flex; } #descriptionToggleBtn:hover { color: #fff; }
        #descriptionToggleIcon { font-size: 20px; transition: transform .4s; } #descriptionToggleBtn.open #descriptionToggleIcon { transform: rotate(180deg); }
        .mx-sec { max-width: 72rem; margin: 56px auto 0; padding: 0 20px; } .mx-sec-sm { margin-top: 20px; }
        #commentsAnchor { max-width: 52rem; }
        .mx-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
        .section-title { font-size: 18px; font-weight: 600; color: #fff; }
        #sortBtn { display: inline-flex; align-items: center; gap: 4px; font-size: 13px; color: #9a9a9a; transition: color .2s; } #sortBtn:hover { color: #fff; }
        #sortBtn .material-symbols-outlined { font-size: 18px; }
        .mx-note { align-items: center; gap: 8px; margin-bottom: 14px; font-size: 13px; color: #fbbf24; }
        .mx-note .material-symbols-outlined { font-size: 18px; }
        .mx-eps { display: grid; gap: 10px; }
        .mx-list.has-more .mx-eps { -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 120px), transparent); mask-image: linear-gradient(to bottom, #000 calc(100% - 120px), transparent); }
        .mx-ep { display: flex; align-items: center; gap: 14px; padding: 10px 12px; border-radius: 16px; background: rgba(255,255,255,.03); border: 1px solid var(--ln); transition: background .25s, border-color .25s; }
        .mx-ep.episode-card:hover { transform: none; background-color: rgba(255,255,255,.06); border-color: rgba(255,255,255,.18); }
        .mx-thumb { width: 76px; height: 52px; border-radius: 11px; overflow: hidden; position: relative; flex: none; background: #1a1a1a; }
        .mx-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s; } .mx-ep:hover .mx-thumb img { transform: scale(1.07); }
        .mx-thumb .hidden { display: none; }
        .chapter-cover-fallback { position: absolute; inset: 0; display: grid; place-items: center; font-weight: 600; color: #fff; background: #222; }
        .mx-lock { position: absolute; inset: 0; display: grid; place-items: center; background: rgba(0,0,0,.62); color: #fbbf24; } .mx-lock .material-symbols-outlined { font-size: 22px; }
        .mx-ep-b { flex: 1; min-width: 0; } .mx-ep-t { font-size: 14.5px; font-weight: 500; color: #fff; } .mx-ep-d { font-size: 12px; color: #7d7d7d; margin-top: 3px; }
        .mx-st { font-size: 12px; font-weight: 500; white-space: nowrap; } .mx-st.free { color: #4ade80; } .mx-st.paid { color: #fbbf24; }
        .new-badge { animation: none; box-shadow: none; top: 4px; right: 4px; padding: 2px 7px; font-size: 9.5px; }
        @keyframes mxIn { from { opacity: 0; transform: translateY(12px); } }
        .mx-enter { animation: mxIn .6s cubic-bezier(.2,.7,.2,1) both; }
        #showMoreBtn { display: flex; align-items: center; gap: 4px; margin: -20px auto 0; position: relative; padding: 9px 20px; border-radius: 99px; font-size: 13px; color: #ddd;
            background: rgba(20,20,20,.85); border: 1px solid rgba(255,255,255,.14); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); transition: .2s; }
        #showMoreBtn:hover { border-color: rgba(255,255,255,.35); color: #fff; } #showMoreBtn[hidden] { display: none; } #showMoreBtn .material-symbols-outlined { font-size: 19px; }
        .chapter-index { background: transparent; border-radius: 16px; }
        .telegram-banner { max-width: 72rem; margin: 40px auto 0; padding: 0 20px; }
        .telegram-banner-link { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; padding: 14px 16px; border-radius: 18px; border: 1px solid var(--ln); background: rgba(255,255,255,.03); color: #fff; }

        function initComments() {
            const messageForm = document.getElementById('messageForm');
            const messageTextArea = document.getElementById('messageText');
            const charCount = document.getElementById('charCount');

            messageTextArea.addEventListener('input', () => charCount.textContent = `${messageTextArea.value.length.toLocaleString('fa-IR')} / ۵۰۰`);

            messageForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                if (!currentUser) {
                    openAuthModal('login');
                    return;
                }
                const name = getDisplayName(currentUser);
                const text = messageTextArea.value.trim();
                if (!text || text.length < 2) return mcToast('نظر باید حداقل ۲ کاراکتر باشد', 'error');

                const submitBtn = messageForm.querySelector('button[type="submit"]');
                submitBtn.disabled = true;
                try {
                    const { error } = await db.from('messages').insert({
                        name, text, manhwa_slug: MANHWA_SLUG, approved: false, user_id: currentUser.id
                    });
                    if (error) throw error;
                    messageForm.reset();
                    charCount.textContent = '۰ / ۵۰۰';
                    showSuccessModal();
                } catch (err) {
                    console.error('خطا در ارسال نظر:', err);
                    mcToast('خطایی پیش اومد، دوباره تلاش کن.', 'error');
                } finally {
                    submitBtn.disabled = false;
                }
            });

            async function loadMessages() {
                const { data: messages, error: messagesError } = await db.from('messages')
                    .select('*')
                    .eq('manhwa_slug', MANHWA_SLUG)
                    .eq('approved', true)
                    .order('created_at', { ascending: false });

                if (messagesError || !messages) {
                    console.error('خطا در دریافت نظرات:', messagesError);
                    if (!globalMainMessages.length) {
                        document.getElementById('messagesList').innerHTML = '<p class="text-text-muted text-center py-4 text-sm">خطا در بارگذاری نظرات. صفحه را دوباره باز کن.</p>';
                    }
                    return;
                }

                const { data: adminReplies } = await db.from('replies').select('*').order('created_at', { ascending: true });

                // نام و آواتار نویسنده‌ها از جدول profiles
                const commentUserIds = [...new Set(messages.map(m => m.user_id).filter(Boolean))];
                const profilesMap = {};
                if (commentUserIds.length > 0) {
                    let { data: profilesData, error: profilesError } = await db.from('profiles').select('id, full_name, avatar_url').in('id', commentUserIds);
                    if (profilesError) {
                        // اگه به هر دلیل ستون آواتار قابل خواندن نبود، حداقل نام‌ها رو بگیر
                        console.error('خطا در دریافت آواتارها:', profilesError.message);
                        ({ data: profilesData } = await db.from('profiles').select('id, full_name').in('id', commentUserIds));
                    }
                    (profilesData || []).forEach(p => { profilesMap[p.id] = { name: p.full_name, avatar: p.avatar_url || '' }; });
                }

                globalUserReplies = messages.filter(msg => msg.parent_message_id !== null);
                globalAdminReplies = adminReplies || [];
                globalMainMessages = messages.filter(msg => msg.parent_message_id === null);
                globalProfilesMap = profilesMap;

                // اگه نظری حذف شده باشه و صفحه‌ی فعلی دیگه وجود نداشته باشه
                const totalPages = Math.max(1, Math.ceil(globalMainMessages.length / commentsPerPage));
                if (currentCommentPage > totalPages) currentCommentPage = totalPages;

                document.getElementById('commentCount').textContent = `(${globalMainMessages.length.toLocaleString('fa-IR')})`;

                renderCommentsPage();
                setupPagination();
            }

            // چند رویداد پشت‌سرهم (مثلاً تایید چند نظر) فقط یک بار رفرش می‌شن
            let reloadTimer = null;
            const scheduleReload = () => { clearTimeout(reloadTimer); reloadTimer = setTimeout(loadMessages, 300); };

            loadMessages();
            // رویداد نظرهای بقیه‌ی مانهواها دیگه باعث رفرش این صفحه نمی‌شه
            db.channel('realtime_comments').on('postgres_changes', { event: '*', schema: 'public', table: 'messages', filter: `manhwa_slug=eq.${MANHWA_SLUG}` }, scheduleReload).subscribe();
            db.channel('realtime_replies').on('postgres_changes', { event: '*', schema: 'public', table: 'replies' }, scheduleReload).subscribe();
        }
        
        function renderCommentsPage() {
            const messagesList = document.getElementById('messagesList');
            messagesList.innerHTML = '';
            
            const startIndex = (currentCommentPage - 1) * commentsPerPage;
            const endIndex = startIndex + commentsPerPage;
            const pageMessages = globalMainMessages.slice(startIndex, endIndex);

            if (pageMessages.length === 0) {
                messagesList.innerHTML = '<p class="text-text-muted text-center py-4 text-sm">هنوز نظری ثبت نشده است.</p>';
                return;
            }

            pageMessages.forEach(msg => {
                const userReplies = globalUserReplies
                    .filter(reply => reply.parent_message_id === msg.id)
                    .map(r => ({
                        ...r,
                        is_admin: false,
                        content: r.text
                    }));

                // پاسخ ادمین ممکنه به خودِ نظر اصلی یا به یکی از ریپلای‌های کاربرها داده شده باشه؛
                // هر دو باید داخل همین رشته (thread) نمایش داده بشن
                const threadTargets = new Map([[msg.id, null]]);
                userReplies.forEach(r => threadTargets.set(r.id, r));
                const adminReplies = globalAdminReplies
                    .filter(reply => threadTargets.has(reply.message_id))
                    .map(r => {
                        const target = threadTargets.get(r.message_id);
                        return {
                            ...r,
                            is_admin: true,
                            reply_to_name: target ? getCommentAuthorName(target) : '',
                            content: r.reply_text || r.text || r.content
                        };
                    });

                const allRepliesSorted = [...userReplies, ...adminReplies].sort((a, b) => new Date(a.created_at) - new Date(b.created_at));

                const repliesHtml = allRepliesSorted.map(reply => {
                    const replyDate = new Date(reply.created_at).toLocaleTimeString('fa-IR', { hour: '2-digit', minute: '2-digit' }) + ' - ' + new Date(reply.created_at).toLocaleDateString('fa-IR');

                    if (reply.is_admin) {
                        return `
                            <div class="admin-reply relative overflow-hidden my-3">
                                <div class="flex items-center justify-between mb-2">
                                    <div class="flex items-center gap-2.5">
                                        <div class="w-7 h-7 rounded-xl bg-primary/20 border border-primary/40 flex items-center justify-center text-primary">
                                            <span class="material-symbols-outlined text-xs font-bold">shield</span>
                                        </div>
                                        <div class="text-white font-bold text-xs flex items-center gap-1.5">
                                            ${escapeHtml(reply.admin_name || 'مدیریت مانهواچی')}
                                            <span class="bg-primary/20 text-primary border border-primary/30 text-[10px] px-2 py-0.5 rounded-md font-semibold">
                                                ${escapeHtml(reply.admin_role || 'ادمین')}
                                            </span>
                                        </div>
                                    </div>
                                    <span class="text-[10px] text-text-muted font-mono" dir="ltr">${replyDate}</span>
                                </div>
                                ${reply.reply_to_name ? `<div class="text-[11px] text-text-muted pr-9 mb-1 flex items-center gap-1"><span class="material-symbols-outlined text-[13px]">subdirectory_arrow_left</span>در پاسخ به ${escapeHtml(reply.reply_to_name)}</div>` : ''}
                                <p class="text-on-surface-variant leading-relaxed text-[14px] pr-9">${escapeHtml(reply.content)}</p>
                            </div>
                        `;
                    } else {
                        return `
                            <div class="reply-thread my-3">
                                <div class="flex justify-between items-center mb-1.5">
                                    <span class="font-semibold text-sm text-gray-200 flex items-center gap-2">
                                        ${avatarHtml(getCommentAuthorName(reply), getCommentAuthorAvatar(reply), { size: 'w-6 h-6', text: 'text-[11px]', radius: 'rounded-lg' })}
                                        ${escapeHtml(getCommentAuthorName(reply))}
                                    </span>
                                    <span class="text-[11px] text-text-muted font-mono" dir="ltr">${replyDate}</span>
                                </div>
                                <p class="text-on-surface-variant text-[14px] leading-relaxed pr-3.5">${escapeHtml(reply.content)}</p>
                            </div>
                        `;
                    }
                }).join('');

                const div = document.createElement('div');
                div.className = 'bg-surface-elevated/70 backdrop-blur-md border border-white/10 hover:border-primary/30 rounded-3xl p-6 transition-all comment-animate shadow-sm';
                const authorName = getCommentAuthorName(msg);
                div.innerHTML = `
                    <div class="flex gap-4">
                        ${avatarHtml(authorName, getCommentAuthorAvatar(msg), { size: 'w-12 h-12', text: 'text-2xl', radius: 'rounded-2xl', extra: 'shadow-lg shadow-red-500/20' })}
                        <div class="flex-1">
                            <div class="flex justify-between items-center">
                                <p class="font-bold text-white text-base">${escapeHtml(authorName)}</p>
                                <span class="text-xs text-text-muted font-mono" dir="ltr">${new Date(msg.created_at).toLocaleTimeString('fa-IR', { hour: '2-digit', minute: '2-digit' })} - ${new Date(msg.created_at).toLocaleDateString('fa-IR')}</span>
                            </div>
                            <p class="mt-2.5 text-[15.2px] leading-relaxed text-on-surface-variant">${escapeHtml(msg.text)}</p>
                            
                            <button onclick="toggleReplyForm(${msg.id})" class="mt-3 text-primary hover:text-red-400 flex items-center gap-1.5 text-xs font-semibold transition bg-primary/10 hover:bg-primary/20 px-3 py-1.5 rounded-xl w-fit">
                                <span class="material-symbols-outlined text-sm">reply</span>پاسخ به نظر
                            </button>
                            
                            <div id="reply-form-${msg.id}" class="reply-box hidden"></div>
                            ${repliesHtml ? `<div class="mt-4 pt-2 border-r-2 border-white/5 pr-2">${repliesHtml}</div>` : ''}

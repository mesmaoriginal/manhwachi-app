        function renderSimilarManhwas(allData, currentSlug, currentGenres = []) {
            const similarSection = document.getElementById('similarSection');
            const similarList = document.getElementById('similarList');
            if (!similarSection || !similarList) return;

            const otherSlugs = Object.keys(allData).filter(slug => slug !== currentSlug);
            if (otherSlugs.length === 0) return;

            const scoredManhwas = otherSlugs.map(slug => {
                const item = allData[slug];
                const sharedGenres = (item.genres || []).filter(g => currentGenres.includes(g)).length;
                return { slug, ...item, scoreMatch: sharedGenres };
            });

            scoredManhwas.sort((a, b) => b.scoreMatch - a.scoreMatch);
            const similarItems = scoredManhwas.slice(0, 10);

            similarList.innerHTML = '';
            similarItems.forEach(item => {
                const card = document.createElement('a');
                card.href = `/manga.php?slug=${item.slug}`;
                card.className = 'snap-start flex-shrink-0 w-36 sm:w-44 bg-surface-elevated border border-white/5 hover:border-primary/40 rounded-2xl overflow-hidden transition-all duration-300 hover:-translate-y-1 group';

                card.innerHTML = `
                    <div class="relative w-full h-48 sm:h-56 bg-zinc-800 overflow-hidden">
                        <img src="/manhwas/${item.slug}/${item.cover_image}" 
                             alt="${escapeHtml(item.title_fa || item.title_en)}" 
                             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                             loading="lazy"
                             onerror="this.src='/ManhwaChi/favicon-192x192.png'" />
                        <div class="absolute top-2 right-2 bg-black/60 backdrop-blur-md text-yellow-400 text-xs font-bold px-2 py-1 rounded-lg flex items-center gap-1">
                            <span class="material-symbols-outlined text-xs">star</span>
                            <span>${item.score || 'N/A'}</span>
                        </div>
                    </div>
                    <div class="p-3">
                        <h4 class="font-bold text-sm text-white line-clamp-1 group-hover:text-primary transition-colors" dir="rtl">
                            ${escapeHtml(item.title_fa || item.title_en)}
                        </h4>
                        <p class="text-xs text-text-muted mt-1 line-clamp-1" dir="ltr">
                            ${escapeHtml(item.title_en)}
                        </p>
                    </div>
                `;
                similarList.appendChild(card);
            });

            similarSection.classList.remove('hidden');
        }

        function setupPagination() {
            const paginationContainer = document.getElementById('paginationContainer');
            const pageNumbers = document.getElementById('pageNumbers');
            const totalPages = Math.ceil(globalMainMessages.length / commentsPerPage);

            if (totalPages <= 1) {
                paginationContainer.classList.add('hidden');
                return;
            }
            paginationContainer.classList.remove('hidden');
            pageNumbers.innerHTML = '';

            document.getElementById('prevPageBtn').disabled = currentCommentPage === 1;
            document.getElementById('nextPageBtn').disabled = currentCommentPage === totalPages;

            const createPageBtn = (pageNum) => {
                const btn = document.createElement('button');
                btn.className = `w-10 h-10 rounded-xl flex items-center justify-center text-sm font-bold transition-all ${pageNum === currentCommentPage ? 'bg-primary text-white shadow-md shadow-primary/20 scale-105' : 'bg-surface-elevated border border-white/10 text-on-surface hover:border-primary/40'}`;
                btn.textContent = pageNum;
                btn.onclick = () => {
                    currentCommentPage = pageNum;
                    renderCommentsPage();
                    setupPagination();
                    document.getElementById('commentsAnchor').scrollIntoView({ behavior: 'smooth' });
                };
                return btn;
            };

            const createDots = () => {
                const span = document.createElement('span');
                span.className = 'w-8 h-10 flex items-end justify-center text-text-muted font-bold select-none pb-1';
                span.textContent = '...';
                return span;
            };

            const maxVisible = 1;
            let pagesToRender = [];

            for (let i = 1; i <= totalPages; i++) {
                if (i === 1 || i === totalPages || (i >= currentCommentPage - maxVisible && i <= currentCommentPage + maxVisible)) {
                    pagesToRender.push(i);
                }
            }

            let lastPage = 0;
            pagesToRender.forEach(pageNum => {
                if (lastPage > 0 && pageNum - lastPage > 1) {
                    pageNumbers.appendChild(createDots());
                }
                pageNumbers.appendChild(createPageBtn(pageNum));
                lastPage = pageNum;
            });

            document.getElementById('prevPageBtn').onclick = () => {
                if (currentCommentPage > 1) {
                    currentCommentPage--;
                    renderCommentsPage();
                    setupPagination();
                    document.getElementById('commentsAnchor').scrollIntoView({ behavior: 'smooth' });
                }
            };

            document.getElementById('nextPageBtn').onclick = () => {
                if (currentCommentPage < totalPages) {
                    currentCommentPage++;
                    renderCommentsPage();
                    setupPagination();
                    document.getElementById('commentsAnchor').scrollIntoView({ behavior: 'smooth' });
                }
            };
        }

        window.toggleReplyForm = function(messageId) {
            if (!currentUser) {
                openAuthModal('login');
                return;
            }

            const form = document.getElementById(`reply-form-${messageId}`);
            document.querySelectorAll('.reply-box').forEach(el => {
                if (el.id !== `reply-form-${messageId}`) el.classList.add('hidden');
            });
            
            form.classList.toggle('hidden');
            if (!form.classList.contains('hidden')) {
                const name = getDisplayName(currentUser);
                form.innerHTML = `
                    <div class="space-y-3 mt-3 animate-fadeIn">
                        <p class="text-xs text-text-muted">پاسخ با نام <span class="text-white font-bold">${escapeHtml(name)}</span> ثبت می‌شه</p>
                        <textarea id="reply-text-${messageId}" rows="3" maxlength="400" class="w-full bg-surface-container border border-white/10 rounded-2xl px-4 py-3 text-sm resize-none focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all" placeholder="پاسخ خود را بنویسید..."></textarea>
                        <div class="flex gap-2">
                            <button onclick="submitReply(${messageId})" id="reply-btn-${messageId}" class="flex-1 bg-primary text-white py-2.5 rounded-xl text-sm font-semibold hover:bg-red-600 active:scale-95 transition-all shadow-lg shadow-primary/20">ارسال پاسخ</button>
                            <button onclick="cancelReply(${messageId})" class="px-5 border border-white/10 py-2.5 rounded-xl text-sm hover:bg-white/5 transition-all">لغو</button>
                        </div>
                    </div>
                `;
            }
        };

        window.submitReply = async function(messageId) {
            if (!currentUser) {
                openAuthModal('login');
                return;
            }

            const textInput = document.getElementById(`reply-text-${messageId}`);
            const btn = document.getElementById(`reply-btn-${messageId}`);

            const name = getDisplayName(currentUser);
            const text = textInput ? textInput.value.trim() : '';

            if (!text || text.length < 2) return alert("متن پاسخ کوتاه است");

            try {
                btn.disabled = true;
                btn.textContent = "در حال ارسال...";

                const { error } = await db.from('messages').insert({
                    name: name,
                    text: text,
                    manhwa_slug: MANHWA_SLUG,
                    approved: false,
                    parent_message_id: messageId,
                    user_id: currentUser.id
                });

                if (error) throw error;

                cancelReply(messageId);
                showSuccessModal();
            } catch (err) {
                console.error("خطا در ارسال پاسخ:", err);
                alert("خطایی رخ داد. لطفا دوباره تلاش کنید.");
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.textContent = "ارسال پاسخ";
                }
            }
        };

        window.cancelReply = function(messageId) { 
            const form = document.getElementById(`reply-form-${messageId}`);
            if (form) form.classList.add('hidden'); 
        };

        function showSuccessModal() { 
            const modal = document.getElementById("successModal"); 
            modal.classList.remove("opacity-0", "pointer-events-none"); 
            modal.classList.add("opacity-100"); 
        }

        document.getElementById("closeSuccessModal").addEventListener("click", () => {
            const modal = document.getElementById("successModal");
            modal.classList.remove("opacity-100");
            modal.classList.add("opacity-0", "pointer-events-none");
        });

        async function updateViewCountDisplay() {
            const { data } = await db.from('manhwa_stats').select('views').eq('slug', MANHWA_SLUG).single();
            if (data) document.getElementById('viewNumber').textContent = Number(data.views || 0);
        }

        function setupBookmarkLogic() {
            const bookmarkBtn = document.getElementById('bookmarkBtn');
            if (!bookmarkBtn) return;
        
            let bookmarks = JSON.parse(localStorage.getItem('manhwachi_bookmarks')) || [];
            let isBookmarked = bookmarks.some(b => b.slug === MANHWA_SLUG);
        
            function updateBookmarkButtonUI() {
                if (isBookmarked) {
                    bookmarkBtn.innerHTML = `<span class="material-symbols-outlined text-3xl text-black font-bold" style="font-variation-settings: 'FILL' 1;">bookmark</span>`;
                    bookmarkBtn.className = "w-14 h-14 bg-primary border-2 border-primary rounded-2xl flex items-center justify-center active:scale-95 transition-all shadow-lg shadow-primary/50";
                } else {
                    bookmarkBtn.innerHTML = `<span class="material-symbols-outlined text-3xl text-primary">bookmark_add</span>`;
                    bookmarkBtn.className = "w-14 h-14 border-2 border-primary text-primary bg-transparent rounded-2xl flex items-center justify-center active:scale-95 transition-all hover:bg-primary/10";
                }
            }
        
            updateBookmarkButtonUI();
        
            bookmarkBtn.addEventListener('click', () => {
                bookmarks = JSON.parse(localStorage.getItem('manhwachi_bookmarks')) || [];
                
                if (isBookmarked) {
                    bookmarks = bookmarks.filter(b => b.slug !== MANHWA_SLUG);
                    isBookmarked = false;
                } else {
                    const coverSrc = document.getElementById('dynamic-cover').getAttribute('src');
                    const itemToSave = {
                        slug: MANHWA_SLUG,
                        title_en: englishTitle,
                        title_fa: persianTitle,
                        cover: coverSrc,
                        savedAt: new Date().toISOString()
                    };
                    bookmarks.push(itemToSave);
                    isBookmarked = true;
                }
        
                localStorage.setItem('manhwachi_bookmarks', JSON.stringify(bookmarks));
                updateBookmarkButtonUI();
            });
        }

        window.onload = () => {
            loadDynamicContent().then(() => {
                setupBookmarkLogic();
            });
            initComments();
            updateViewCountDisplay();
        };
    </script>
</body>
</html>

        // (بررسی نهایی و دقیق‌تر خود صفحه ریدر انجام می‌شه)
        async function goToChapter(epNum, isFree) {
            const readerUrl = `/reader.html?slug=${encodeURIComponent(MANHWA_SLUG)}&ch=${encodeURIComponent(epNum)}`;

            // به محض تلاش برای باز کردن چپتر، به عنوان خوانده‌شده ثبتش می‌کنیم تا نشان «جدید» برداشته شود
            ChapterReadService.markRead(MANHWA_SLUG, epNum);

            if (isFree) {
                window.location.href = readerUrl;
                return;
            }

            if (!currentUser) {
                window.location.href = SUBSCRIPTION_PAGE_URL;
                return;
            }

            if (!subscriptionChecked) {
                await refreshSubscriptionStatus();
            }

            // اگه وضعیت اشتراک نامعلوم بود (خطای شبکه) کاربر مشترک رو به صفحه‌ی خرید نمی‌فرستیم
            if (subscriptionUnknown) {
                window.location.href = readerUrl;
                return;
            }
            window.location.href = currentUserSubscribed ? readerUrl : SUBSCRIPTION_PAGE_URL;
        }


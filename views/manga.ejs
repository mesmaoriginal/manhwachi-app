<!DOCTYPE html>
<html class="dark" lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta name="robots" content="<%= manhwa ? 'index, follow, max-image-preview:large' : 'noindex, follow' %>">

    <!-- SEO Meta Tags -->
    <title><%= seo_title %></title>
    <meta name="description" content="<%= seo_desc %>">
    <link rel="canonical" href="<%= canonical_url %>" />

    <!-- Open Graph / Facebook / Telegram -->
    <meta property="og:type" content="book" />
    <meta property="og:site_name" content="مانهواچی" />
    <meta property="og:title" content="<%= seo_title %>" />
    <meta property="og:description" content="<%= seo_desc %>" />
    <meta property="og:image" content="<%= full_cover_url %>" />
    <meta property="og:url" content="<%= canonical_url %>" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="<%= seo_title %>" />
    <meta name="twitter:description" content="<%= seo_desc %>" />
    <meta name="twitter:image" content="<%= full_cover_url %>" />

    <!-- Favicons -->
    <link rel="icon" href="/ManhwaChi/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/ManhwaChi/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/ManhwaChi/favicon-192x192.png" />
    <link rel="apple-touch-icon" href="/ManhwaChi/apple-touch-icon.png" />

    <!-- Google Structured Data (Schema.org) for SEO Rich Snippets -->
    <% if (manhwa) { %>
    <%
      var _gl = (typeof genre_links !== 'undefined' && genre_links.length) ? genre_links : genres.map(function(g){ return { name: g, slug: null }; });
      var _rd = (typeof release_date !== 'undefined' && release_date) ? String(release_date) : '';
      var _validDate = /^(19|20)\d{2}(-\d{2}){0,2}$/.test(_rd); // تاریخ شمسی (۱۴۰۳/..) در اسکیما نامعتبر است
      var _series = {
        "@type": "ComicSeries",
        "@id": canonical_url + "#series",
        "name": title_fa || title_en,
        "alternateName": (title_fa && title_en) ? title_en : undefined,
        "description": raw_desc || seo_desc,
        "image": full_cover_url,
        "url": canonical_url,
        "inLanguage": "fa",
        "genre": _gl.map(function(g){ return g.name; }),
        "datePublished": _validDate ? _rd : undefined
      };
      var _crumbs = {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "خانه", "item": "https://manhwachi.ir/" },
          { "@type": "ListItem", "position": 2, "name": "آرشیو مانهوا", "item": "https://manhwachi.ir/library-page.html" },
          { "@type": "ListItem", "position": 3, "name": title_fa || title_en, "item": canonical_url }
        ]
      };
    %>
    <script type="application/ld+json">
    <%- JSON.stringify({ "@context": "https://schema.org", "@graph": [_series, _crumbs] }).replace(/</g, '\\u003c') %>
    </script>
    <% } %>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-18XD50KTY3"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-18XD50KTY3');
    </script>
    
    <link rel="stylesheet" href="/css/tailwind.css">
    <script>
      // اگر فایل کامپایل‌شده‌ی کامل Tailwind (با نشانه‌ی --mc-tw) نبود، مثل قبل از CDN لود می‌شود
      (function () {
        var ok = false;
        try { ok = !!getComputedStyle(document.documentElement).getPropertyValue('--mc-tw').trim(); } catch (e) {}
        window.__twLocal = ok;
        window.__twFallback = function (cb) {
          var s = document.createElement('script');
          s.src = 'https://cdn.tailwindcss.com?plugins=forms,container-queries';
          if (cb) s.onload = cb;
          document.head.appendChild(s);
        };
        
      })();
    </script>
    <link rel="stylesheet" href="/css/vendor/montserrat.css" onerror="this.onerror=null;this.media='print';this.onload=function(){this.media='all'};this.href='https://fonts.googleapis.com/css2?family=Montserrat:wght@400..800&amp;display=swap'">
    <link rel="stylesheet" href="/css/vendor/inter.css" onerror="this.onerror=null;this.media='print';this.onload=function(){this.media='all'};this.href='https://fonts.googleapis.com/css2?family=Inter:wght@400..700&amp;display=swap'">
    <link rel="stylesheet" href="/css/vendor/material-symbols.css" onerror="this.onerror=null;this.media='print';this.onload=function(){this.media='all'};this.href='https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=block'">
    <link rel="stylesheet" href="/css/vendor/vazirmatn.css" onerror="this.onerror=null;this.media='print';this.onload=function(){this.media='all'};this.href='https://fonts.googleapis.com/css2?family=Vazirmatn:wght@100..900&amp;display=swap'">
        <link rel="stylesheet" href="/css/vendor/fontawesome.css" onerror="this.onerror=null;this.media='print';this.onload=function(){this.media='all'};this.href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css'">
        <script id="tailwind-config">
        if (!window.__twLocal) window.__twFallback(function () {
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        primary: "#DC2626",
                        "on-primary": "#ffff",
                        surface: "#000000",
                        "surface-elevated": "#161616",
                        "surface-shadow":"#241717 ",
                        "surface-container": "#1f1f1f",
                        "on-surface": "#e2e2e2",
                        "on-surface-variant": "#cbb8b8",
                        "text-muted": "#8C8C8C",
                    }
                }
            }
        }
    });
    </script>

    <style>
        body { font-family: 'Vazirmatn', 'Inter', system-ui, sans-serif; font-weight: 400; -webkit-font-smoothing: antialiased; }
        /* سبک‌تر کردن وزن فونت‌ها تا با صفحه اصلی هماهنگ بشه */
        body .font-bold { font-weight: 600; }
        body .font-semibold { font-weight: 500; }
        .animate-fadeIn { animation: fadeIn 0.3s ease; }
        .glass-scrim {
            background: linear-gradient(to top, #000000 10%, rgba(0, 0, 0, 0.7) 50%, transparent 100%);
        }
        .text-shadow-glow {
            text-shadow: 0 0 20px rgb(220 38 38 / var(--tw-bg-opacity, 1));
        }
        .episode-card {
            transition: all 0.3s ease;
        }
        .episode-card:hover {
            transform: translateX(-10px);
            background-color: #2a2a2a;
        }
        .new-badge {
            position: absolute;
            top: 6px;
            right: 6px;
            z-index: 20;
            display: inline-flex;
            align-items: center;
            gap: 3px;
            padding: 2.5px 8px;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.3px;
            color: #fff;
            background: linear-gradient(135deg, #ff4d4d, #dc2626);
            border-radius: 999px;
            box-shadow: 0 0 10px rgba(220, 38, 38, 0.65), 0 2px 6px rgba(0,0,0,0.4);
            animation: newBadgePulse 1.8s ease-in-out infinite;
            pointer-events: none;
        }
        .new-badge::before {
            content: "";
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: #fff;
            box-shadow: 0 0 6px #fff;
        }
        @keyframes newBadgePulse {
            0%, 100% { box-shadow: 0 0 8px rgba(220, 38, 38, 0.55), 0 2px 6px rgba(0,0,0,0.4); transform: scale(1); }
            50% { box-shadow: 0 0 16px rgba(220, 38, 38, 0.95), 0 2px 6px rgba(0,0,0,0.4); transform: scale(1.06); }
        }
        @media (min-width: 1024px) {
            .text-shadow-glow { text-shadow: none; }
            .episode-card:hover { transform: translateY(-4px); background-color: #2a2a2a; }
        }
        .border-white {
            --tw-border-opacity: 1;
            border-color: rgb(255 255 255 / 27%);
        }
        .manhwa-card {
            position: relative;
            overflow: hidden;
        }
        .manhwa-card::before {
            content: "";
            position: absolute;
            width: 450px;
            height: 450px;
            background: #dc2626;
            opacity: 0.15;
            filter: blur(120px);
            top: -220px;
            left: 50%;
            transform: translateX(-50%);
            pointer-events: none;
        }
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #1f1f1f; }
        ::-webkit-scrollbar-thumb { background: rgb(220 38 38 / var(--tw-bg-opacity, 1)); border-radius: 10px; }

        .reply-box { margin-top:12px; padding:16px; background:#1f1f1f; border-radius:16px; border:1px solid rgba(255,255,255,0.08); }
        .reply-thread {
            border-right: 3px solid rgba(255, 255, 255, 0.08);
            margin-right: 8px;
            padding-right: 14px;
            background: rgba(255, 255, 255, 0.015);
            padding-top: 8px;
            padding-bottom: 8px;
            border-radius: 0 12px 12px 0;
            transition: all 0.2s ease;
        }
        .reply-thread:hover {
            border-right-color: rgba(220, 38, 38, 0.5);
            background: rgba(255, 255, 255, 0.03);
        }

        .admin-reply {
            background: linear-gradient(135deg, rgba(220, 38, 38, 0.08) 0%, rgba(0, 0, 0, 0.3) 100%);
            border: 1px solid rgba(220, 38, 38, 0.25);
            border-right: 3px solid #DC2626;
            border-radius: 16px;
            padding: 14px 16px;
            box-shadow: 0 4px 20px rgba(220, 38, 38, 0.05);
        }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .comment-animate { animation: fadeIn 0.5s cubic-bezier(0.4, 0, 0.2, 1); }

        .description-text { max-height: 132px; }
        .description-text.expanded { max-height: 2000px; }
        .description-fade.hidden-fade { opacity: 0; }
        #descriptionToggleBtn.flex-visible { display: flex; }

        .telegram-banner{
            margin:28px 0;
            padding:0 18px;
        }
        .telegram-banner-link{
            display:flex;
            align-items:center;
            justify-content:space-between;
            gap:16px;
            width:100%;
            padding:18px 22px;
            border-radius:22px;
            text-decoration:none;
            color:#fff;
            background:linear-gradient(135deg,#229ED9,#1668c7);
            box-shadow: 0 12px 35px rgba(34,158,217,.28), inset 0 1px rgba(255,255,255,.15);
            position:relative;
            overflow:hidden;
        }
        .telegram-banner-link::before{
            content:"";
            position:absolute;
            top:-70px;
            right:-40px;
            width:180px;
            height:180px;
            background:rgba(255,255,255,.12);
            border-radius:50%;
        }
        #copyTelegramBtn {
            border:none;
            cursor:pointer;
            font-family:inherit;
        }
        .telegram-icon{
            width:64px;
            height:64px;
            flex-shrink:0;
            border-radius:50%;
            background:rgba(255,255,255,.15);
            display:flex;
            justify-content:center;
            align-items:center;
            backdrop-filter:blur(8px);
        }
        .telegram-icon img{ width:38px; height:38px; }
        .telegram-content{ flex:1; margin:0 10px; }
        .telegram-title{ font-size:16px; font-weight:600; margin-bottom:5px; }
        .telegram-subtitle{ font-size:14px; opacity:.95; }
        .telegram-btn{
            background:#fff;
            color:#1b84d6;
            padding:12px 22px;
            border-radius:14px;
            font-weight:700;
            transition:.25s;
            white-space:nowrap;
        }
        .telegram-banner-link:hover .telegram-btn{ transform:scale(1.06); }
        
        @media(max-width:700px){
            .telegram-banner-link{ padding:16px; }
            .telegram-icon{ width:52px; height:52px; }
            .telegram-icon img{ width:30px; height:30px; }
            .telegram-title{ font-size:15px; }
            .telegram-subtitle{ font-size:13px; }
            .telegram-btn{ padding:10px 16px; font-size:13px; }
        }

        #mobile-drawer { transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1); }
        #drawer-overlay { transition: opacity 0.3s ease, visibility 0.3s ease; }
        .drawer-open #mobile-drawer { transform: translateX(0) !important; }
        .drawer-open #drawer-overlay { opacity: 1 !important; visibility: visible !important; pointer-events: auto !important; }
        .drawer-item { transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1); }
        .drawer-item:hover {
            background: rgba(220, 38, 38, 0.12);
            border-color: rgba(220, 38, 38, 0.3);
            transform: translateX(-4px);
        }
        .nav-link { position: relative; }
        .nav-link::after {
            content: '';
            position: absolute;
            bottom: -4px;
            right: 0;
            width: 0;
            height: 2px;
            background-color: #DC2626;
            transition: width 0.3s ease;
        }
        .nav-link:hover::after { width: 100%; }

        .scrollbar-none::-webkit-scrollbar { display: none; }
        .scrollbar-none { -ms-overflow-style: none; scrollbar-width: none; }
        /* اندازه‌ی استاندارد متن‌های منوی کشویی */
        #mobileDrawer .drawer-item { font-size: 13.5px; padding: 11px 12px; gap: 11px; }
        #mobileDrawer .drawer-item .text-sm { font-size: 13.5px; }
        #mobileDrawer .drawer-item > div:first-child,
        #mobileDrawer .drawer-item .w-9 { width: 34px; height: 34px; }
        #mobileDrawer .drawer-item .material-symbols-outlined { font-size: 20px; }
        #mobileDrawer a[href*="telegram"] { padding: 12px 14px; }
        #mobileDrawer a[href*="telegram"] .text-sm { font-size: 13px; }
        #mobileDrawer a[href*="telegram"] .material-symbols-outlined.text-2xl { font-size: 22px; }

        /* =====================================================================
           Desktop redesign (>= 1024px) — mobile / tablet layout is untouched
           ===================================================================== */
        .desktop-backdrop { display: none; }

        @keyframes backdropIn { from { opacity: 0; } to { opacity: 1; } }
        @keyframes backdropDrift {
            from { transform: scale(1.15) translate3d(0, 0, 0); }
            to   { transform: scale(1.26) translate3d(-1.5%, 1.8%, 0); }
        }

        @media (min-width: 1024px) {
            main.manhwa-main { position: relative; isolation: isolate; }

            /* --- blurred cover backdrop that fades out toward the bottom --- */
            .desktop-backdrop {
                display: block;
                position: absolute;
                z-index: -1;
                top: -64px; left: 0; right: 0;
                height: 920px;
                overflow: hidden;
                pointer-events: none;
                -webkit-mask-image: linear-gradient(to bottom, #000 0%, rgba(0,0,0,.85) 38%, rgba(0,0,0,.35) 72%, transparent 100%);
                        mask-image: linear-gradient(to bottom, #000 0%, rgba(0,0,0,.85) 38%, rgba(0,0,0,.35) 72%, transparent 100%);
                animation: backdropIn 1.4s ease-out both;
            }
            .desktop-backdrop img {
                width: 100%; height: 100%;
                object-fit: cover;
                object-position: center 22%;
                filter: blur(14px) saturate(1.25) brightness(.9);
                opacity: .34;
                transform: scale(1.15);
                animation: backdropDrift 40s ease-in-out infinite alternate;
                will-change: transform;
            }
            .desktop-backdrop::after {
                content: "";
                position: absolute; inset: 0;
                background:
                    radial-gradient(ellipse 55% 50% at 22% 26%, rgba(220,38,38,.24), transparent 70%),
                    radial-gradient(ellipse 80% 70% at 50% 0%, transparent 45%, rgba(0,0,0,.55) 100%),
                    linear-gradient(to right, rgba(0,0,0,.6), transparent 20%, transparent 80%, rgba(0,0,0,.6));
            }

            /* --- cover --- */
            main #dynamic-cover {
                border: 1px solid rgba(255,255,255,.14);
                box-shadow: 0 30px 70px -20px rgba(0,0,0,.85), 0 0 80px -15px rgba(220,38,38,.45);
                transition: transform .5s cubic-bezier(.16,1,.3,1), box-shadow .5s ease;
            }
            main #dynamic-cover:hover {
                transform: translateY(-6px) scale(1.015);
                box-shadow: 0 40px 90px -20px rgba(0,0,0,.9), 0 0 110px -10px rgba(220,38,38,.6);
            }

            /* --- title block --- */
            main #manhwaTitle { letter-spacing: -.02em; line-height: 1.1; }
            main .hero-info { position: relative; border-bottom-color: transparent; padding-bottom: 30px; }
            main .hero-info::after {
                content: "";
                position: absolute; bottom: 0; right: 0; left: 0; height: 1px;
                background: linear-gradient(to left, rgba(220,38,38,.75), rgba(255,255,255,.1) 45%, transparent);
            }
            main #type > * {
                padding: 7px 18px;
                font-size: 12.5px;
                border: 1px solid rgba(255,255,255,.1);
                transition: background-color .25s ease, border-color .25s ease, transform .25s ease;
            }
            main #type > span:first-child { border-color: rgba(255,255,255,.22); box-shadow: 0 0 22px rgba(220,38,38,.5); }
            main #type > a:hover { border-color: rgba(220,38,38,.6); transform: translateY(-2px); }
            main .hero-info > div:last-child { gap: 12px; flex-wrap: wrap; }
            main .hero-info > div:last-child > * {
                padding: 6px 14px;
                border-radius: 999px;
                background: rgba(255,255,255,.06);
                border: 1px solid rgba(255,255,255,.09);
                -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
            }

            /* --- description as a glass card --- */
            main .manhwa-card {
                padding: 22px 28px 20px;
                background: rgba(16,12,12,.6);
                -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px);
                border: 1px solid rgba(255,255,255,.08);
                border-radius: 24px;
                box-shadow: 0 24px 60px -30px rgba(0,0,0,.9), inset 0 1px 0 rgba(255,255,255,.05);
            }
            main #dynamic-description { color: #d9cccc; font-size: 16px; line-height: 2; }
            main .description-text { max-height: 160px; }
            main .description-text.expanded { max-height: 2000px; }
            main #descriptionFade { background-image: linear-gradient(to top, rgba(18,13,13,.96), transparent); }

            /* --- action buttons --- */
            main #readBtn {
                position: relative; overflow: hidden;
                height: 56px; font-size: 17px; border-radius: 16px;
                background-image: linear-gradient(135deg, #ef4444 0%, #dc2626 45%, #991b1b 100%);
                box-shadow: 0 10px 30px -8px rgba(220,38,38,.65), inset 0 1px 0 rgba(255,255,255,.25);
                transition: transform .25s ease, box-shadow .25s ease;
            }
            main #readBtn::after {
                content: ""; position: absolute; top: 0; bottom: 0; left: -80%; width: 55%;
                background: linear-gradient(100deg, transparent, rgba(255,255,255,.3), transparent);
                transform: skewX(-20deg);
                transition: left .8s ease;
                pointer-events: none;
            }
            main #readBtn:hover { transform: translateY(-2px); box-shadow: 0 16px 40px -8px rgba(220,38,38,.85), inset 0 1px 0 rgba(255,255,255,.3); }
            main #readBtn:hover::after { left: 135%; }
            main #readBtn:active { transform: scale(.97); }
            main #bookmarkBtn, main #shareBtn {
                width: 56px; height: 56px; border-radius: 16px;
                -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
            }
            main #shareBtn { background-color: rgba(220,38,38,.06); transition: background-color .25s ease, transform .2s ease; }
            main #shareBtn:hover { background-color: rgba(220,38,38,.2); }

            /* --- stat cards --- */
            main .stat-card {
                position: relative; overflow: hidden;
                background-image: linear-gradient(145deg, rgba(34,26,26,.78), rgba(14,12,12,.78));
                -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
                border: 1px solid rgba(255,255,255,.08);
                transition: transform .3s ease, border-color .3s ease, box-shadow .3s ease;
            }
            main .stat-card::before {
                content: ""; position: absolute; top: 0; right: 0; width: 64px; height: 2px;
                background: linear-gradient(to left, #dc2626, transparent);
            }
            main .stat-card:hover {
                transform: translateY(-3px);
                border-color: rgba(220,38,38,.4);
                box-shadow: 0 14px 34px -14px rgba(220,38,38,.5);
            }

            /* --- sections --- */
            main .telegram-banner { padding: 0 32px; }
            main .section-title { font-size: 22px; position: relative; padding-right: 16px; }
            main .section-title::before {
                content: ""; position: absolute; right: 0; top: 50%; transform: translateY(-50%);
                width: 4px; height: 26px; border-radius: 4px;
                background: linear-gradient(to bottom, #ef4444, #7f1d1d);
                box-shadow: 0 0 14px rgba(220,38,38,.7);
            }
            main #sortBtn {
                padding: 8px 16px; border-radius: 999px;
                background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1);
                transition: background-color .25s ease, border-color .25s ease;
            }
            main #sortBtn:hover { background: rgba(220,38,38,.15); border-color: rgba(220,38,38,.45); }

            /* --- episode cards --- */
            main .episode-card {
                position: relative; overflow: hidden;
                background-image: linear-gradient(145deg, rgba(30,25,25,.85), rgba(16,14,14,.85));
                border: 1px solid rgba(255,255,255,.06);
                transition: transform .3s ease, border-color .3s ease, box-shadow .3s ease, background-image .3s ease;
            }
            main .episode-card::before {
                content: ""; position: absolute; top: 0; bottom: 0; right: 0; width: 3px;
                background: linear-gradient(to bottom, #ef4444, #7f1d1d);
                opacity: 0; transition: opacity .3s ease;
            }
            main .episode-card:hover {
                transform: translateY(-4px);
                background-image: linear-gradient(145deg, rgba(44,32,32,.92), rgba(24,19,19,.92));
                border-color: rgba(220,38,38,.4);
                box-shadow: 0 16px 36px -16px rgba(220,38,38,.5);
            }
            main .episode-card:hover::before { opacity: 1; }
            main .episode-card .chapter-cover-img { transition: transform .5s ease; }
            main .episode-card:hover .chapter-cover-img { transform: scale(1.1); }
        }

        @media (min-width: 1024px) and (prefers-reduced-motion: reduce) {
            .desktop-backdrop, .desktop-backdrop img { animation: none; }
        }
    /* ===== دکمه‌ی دانلود چپتر (انیمیشنی) + مودال پرمیوم ===== */
    .dl-btn { position: relative; flex: 0 0 auto; width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; cursor: pointer;
        color: #fca5a5; background: radial-gradient(circle at 30% 25%, rgba(239,68,68,.28), rgba(127,29,29,.18));
        border: 1px solid rgba(239,68,68,.35); -webkit-tap-highlight-color: transparent;
        transition: transform .25s cubic-bezier(.2,.9,.3,1.4), box-shadow .3s, color .3s, background .3s, border-color .3s; }
    .dl-btn::after { content: ""; position: absolute; inset: -1px; border-radius: 50%; border: 2px solid rgba(239,68,68,.55); opacity: 0; pointer-events: none;
        animation: dlPing 3.2s ease-out infinite; }
    @keyframes dlPing { 0%, 70% { transform: scale(1); opacity: 0; } 75% { opacity: .7; } 100% { transform: scale(1.55); opacity: 0; } }
    .dl-btn:hover { transform: scale(1.12); color: #fff; box-shadow: 0 0 0 4px rgba(239,68,68,.15), 0 10px 24px -8px rgba(239,68,68,.7); }
    .dl-btn:active { transform: scale(.9); }
    .dl-svg { width: 30px; height: 30px; overflow: visible; }
    .dl-svg * { fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
    .dl-ring-bg { stroke: rgba(255,255,255,.08) !important; stroke-width: 2 !important; }
    .dl-ring { stroke: #ef4444 !important; stroke-width: 2.6 !important; stroke-dasharray: 119.4; stroke-dashoffset: 119.4; transform: rotate(-90deg); transform-origin: 22px 22px; transition: stroke-dashoffset .25s ease; }
    .dl-arrow { animation: dlBob 2.4s ease-in-out infinite; }
    @keyframes dlBob { 0%, 55%, 100% { transform: translateY(0); } 70% { transform: translateY(2.5px); } 85% { transform: translateY(-1.5px); } }
    .dl-btn:hover .dl-arrow { animation: dlBobFast .7s ease-in-out infinite; }
    @keyframes dlBobFast { 0%, 100% { transform: translateY(-1px); } 50% { transform: translateY(3px); } }
    .dl-tray { opacity: .75; }
    .dl-check { stroke-dasharray: 30; stroke-dashoffset: 30; opacity: 0; }
    /* در حال دانلود */
    .dl-btn[data-state="loading"] { cursor: progress; color: #fff; background: rgba(239,68,68,.18); }
    .dl-btn[data-state="loading"]::after { animation: none; opacity: 0; }
    .dl-btn[data-state="loading"] .dl-arrow { animation: dlFall .9s ease-in infinite; }
    @keyframes dlFall { 0% { transform: translateY(-5px); opacity: 0; } 40% { opacity: 1; } 100% { transform: translateY(4px); opacity: 0; } }
    /* ذخیره‌شده */
    .dl-btn[data-state="done"] { color: #4ade80; background: radial-gradient(circle at 30% 25%, rgba(74,222,128,.28), rgba(20,83,45,.2)); border-color: rgba(74,222,128,.45); animation: dlPop .5s cubic-bezier(.2,.9,.3,1.5); }
    .dl-btn[data-state="done"]::after { border-color: rgba(74,222,128,.5); animation: none; }
    .dl-btn[data-state="done"] .dl-arrow, .dl-btn[data-state="done"] .dl-tray { opacity: 0; animation: none; }
    .dl-btn[data-state="done"] .dl-ring { stroke: #4ade80 !important; stroke-dashoffset: 0; }
    .dl-btn[data-state="done"] .dl-check { opacity: 1; animation: dlDraw .55s .1s ease forwards; }
    @keyframes dlDraw { to { stroke-dashoffset: 0; } }
    @keyframes dlPop { 0% { transform: scale(.7); } 60% { transform: scale(1.18); } 100% { transform: scale(1); } }
    @media (prefers-reduced-motion: reduce) { .dl-btn, .dl-btn::after, .dl-arrow, .dl-check { animation: none !important; transition: none !important; } .dl-btn[data-state="done"] .dl-check { stroke-dashoffset: 0; } }

    .dl-toast { position: fixed; left: 50%; bottom: 24px; z-index: 10001; transform: translate(-50%, 20px); opacity: 0; pointer-events: none; direction: rtl;
        max-width: calc(100vw - 32px); padding: 12px 18px; border-radius: 14px; font-size: .85rem; color: #e4e4e7;
        background: rgba(24,24,27,.96); border: 1px solid rgba(255,255,255,.1); box-shadow: 0 14px 40px -10px rgba(0,0,0,.8); transition: opacity .25s, transform .25s; }
    .dl-toast.show { opacity: 1; transform: translate(-50%, 0); }

    .pm-overlay { position: fixed; inset: 0; z-index: 10000; display: flex; align-items: center; justify-content: center; padding: 20px;
        background: rgba(0,0,0,.72); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); opacity: 0; pointer-events: none; transition: opacity .25s ease; }
    .pm-overlay.show { opacity: 1; pointer-events: auto; }
    .pm-card { position: relative; width: 100%; max-width: 380px; text-align: center; direction: rtl; overflow: hidden;
        padding: 34px 24px 24px; border-radius: 28px; color: #fff;
        background: radial-gradient(120% 80% at 50% -10%, rgba(240,195,95,.22), transparent 60%), linear-gradient(180deg, #17120a, #0b0905);
        border: 1px solid rgba(240,195,95,.35); box-shadow: 0 30px 80px -20px rgba(232,182,74,.35), 0 0 0 1px rgba(0,0,0,.6) inset;
        transform: translateY(24px) scale(.94); transition: transform .35s cubic-bezier(.2,.9,.3,1.2); }
    .pm-overlay.show .pm-card { transform: none; }
    .pm-close { position: absolute; top: 12px; left: 12px; width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center;
        background: rgba(255,255,255,.07); color: #a1a1aa; transition: background .2s, color .2s; }
    .pm-close:hover { background: rgba(255,255,255,.14); color: #fff; }
    .pm-crown { width: 76px; height: 76px; margin: 0 auto 16px; border-radius: 50%; display: grid; place-items: center;
        background: linear-gradient(135deg, #f0c35f, #b8862b); color: #1a1204; box-shadow: 0 10px 30px -6px rgba(232,182,74,.6); animation: pmFloat 3s ease-in-out infinite; }
    .pm-crown .material-symbols-outlined { font-size: 40px; font-variation-settings: 'FILL' 1; }
    @keyframes pmFloat { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }
    .pm-title { font-size: 1.3rem; font-weight: 800; margin-bottom: 6px;
        background: linear-gradient(90deg, #f6d98a, #e8b64a, #f6d98a); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .pm-sub { font-size: .85rem; color: #a1a1aa; line-height: 1.8; margin-bottom: 18px; }
    .pm-list { list-style: none; padding: 0; margin: 0 0 22px; text-align: right; display: grid; gap: 10px; }
    .pm-list li { display: flex; align-items: center; gap: 10px; font-size: .88rem; color: #e4e4e7; padding: 10px 12px;
        border-radius: 14px; background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.05); }
    .pm-list .material-symbols-outlined { font-size: 20px; color: #e8b64a; }
    .pm-buy { display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; padding: 14px; border-radius: 16px; font-weight: 800; font-size: .95rem;
        background: linear-gradient(135deg, #f0c35f, #b8862b); color: #1a1204; box-shadow: 0 10px 26px -8px rgba(232,182,74,.6); transition: transform .15s; }
    .pm-buy:active { transform: scale(.97); }
    .pm-later { margin-top: 10px; width: 100%; padding: 10px; font-size: .8rem; color: #71717a; }
    .pm-later:hover { color: #d4d4d8; }
    @media (prefers-reduced-motion: reduce) { .pm-crown { animation: none; } .pm-card, .pm-overlay { transition: none; } }
    </style>

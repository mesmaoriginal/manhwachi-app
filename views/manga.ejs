        function setupBookmarkLogic() {
            const bookmarkBtn = document.getElementById('bookmarkBtn');
            if (!bookmarkBtn) return;

            const LS_KEY = 'manhwachi_bookmarks';
            const readLocal = () => {
                try {
                    const v = JSON.parse(localStorage.getItem(LS_KEY));
                    return Array.isArray(v) ? v : [];
                } catch (e) { return []; }
            };
            const writeLocal = (list) => {
                try { localStorage.setItem(LS_KEY, JSON.stringify(list)); } catch (e) { /* localStorage غیرفعال یا پر است */ }
            };
            const coverSrc = () => document.getElementById('dynamic-cover').getAttribute('src');
            const makeLocalItem = () => ({
                slug: MANHWA_SLUG,
                title_en: englishTitle,
                title_fa: persianTitle,
                cover: coverSrc(),
                savedAt: new Date().toISOString()
            });

            let isBookmarked = readLocal().some(b => b.slug === MANHWA_SLUG);

            function updateBookmarkButtonUI() {
                if (isBookmarked) {
                    bookmarkBtn.innerHTML = `<span class="material-symbols-outlined text-2xl text-white" style="font-variation-settings: 'FILL' 1;">bookmark</span>`;
                    bookmarkBtn.className = "w-12 h-12 bg-primary border border-primary rounded-xl flex items-center justify-center active:scale-95 transition-all shadow-lg shadow-primary/50";
                } else {
                    bookmarkBtn.innerHTML = `<span class="material-symbols-outlined text-2xl text-primary">bookmark_add</span>`;
                    bookmarkBtn.className = "w-12 h-12 border border-primary/70 text-primary bg-transparent rounded-xl flex items-center justify-center active:scale-95 transition-all hover:bg-primary/10";
                }
            }
            updateBookmarkButtonUI();

            // ---- همگام‌سازی با جدول bookmarks (همون چیزی که صفحه‌ی پروفایل نشون می‌ده) ----
            async function remoteHas() {
                const { data, error } = await db.from('bookmarks').select('id')
                    .eq('user_id', currentUser.id).eq('manhwa_slug', MANHWA_SLUG).limit(1);
                if (error) throw error;
                return !!(data && data.length);
            }
            async function remoteAdd() {
                if (await remoteHas()) return;
                const { error } = await db.from('bookmarks').insert({
                    user_id: currentUser.id,
                    manhwa_slug: MANHWA_SLUG,
                    title_en: englishTitle,
                    title_fa: persianTitle,
                    cover_url: coverSrc()
                });
                if (error) throw error;
            }
            async function remoteRemove() {
                const { error } = await db.from('bookmarks').delete()
                    .eq('user_id', currentUser.id).eq('manhwa_slug', MANHWA_SLUG);
                if (error) throw error;
            }

            let lastSyncedUserId = null;
            async function syncFromServer() {
                if (!currentUser) { lastSyncedUserId = null; return; }
                if (lastSyncedUserId === currentUser.id) return;
                lastSyncedUserId = currentUser.id;
                try {
                    const has = await remoteHas();
                    if (has && !isBookmarked) {
                        // قبلاً روی حساب (مثلاً دستگاه دیگه) نشان شده
                        const list = readLocal();
                        if (!list.some(b => b.slug === MANHWA_SLUG)) { list.push(makeLocalItem()); writeLocal(list); }
                        isBookmarked = true;
                        updateBookmarkButtonUI();
                    } else if (!has && isBookmarked) {
                        // فقط روی همین مرورگر نشان شده بود (مثلاً قبل از ورود) → به حساب اضافه می‌شه
                        await remoteAdd();
                    }
                } catch (err) {
                    lastSyncedUserId = null;
                    console.error('همگام‌سازی نشان‌ها با حساب کاربری ناموفق بود:', err);
                }
            }
            bookmarkSyncFn = syncFromServer;
            syncFromServer();

            bookmarkBtn.addEventListener('click', async () => {
                const list = readLocal();
                if (isBookmarked) {
                    writeLocal(list.filter(b => b.slug !== MANHWA_SLUG));
                    isBookmarked = false;
                } else {
                    list.push(makeLocalItem());
                    writeLocal(list);
                    isBookmarked = true;
                }
                updateBookmarkButtonUI();

                if (currentUser) {
                    try {
                        if (isBookmarked) await remoteAdd(); else await remoteRemove();
                    } catch (err) {
                        console.error('ذخیره‌ی نشان روی حساب کاربری ناموفق بود:', err);
                    }
                }
            });
        }

        // window.onload منتظر همه‌ی تصاویر/فونت‌ها (از جمله نماد اعتماد خارجی) می‌مونه و
        // اگه اون کند بود، نظرها و لیست چپترها دیر لود می‌شدن؛ پس مستقیم بعد از آماده شدن DOM اجرا می‌شه
        function startPage() {
            refreshInitialNewBadges();
            loadDynamicContent().then(() => {
                setupBookmarkLogic();
            });
            initComments();
            updateViewCountDisplay();
        }
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', startPage);
        } else {
            startPage();
        }
    </script>


<script src="/mc-ui.js?v=1" defer></script>
<script src="/app-promo.js?v=1" defer></script>
</body>
</html>

        // ===== سرویس ذخیره‌سازی وضعیت «خوانده‌شده» چپترها (برای برداشتن نشان «جدید») =====
        const ChapterReadService = {
            storageKey: 'manhwachi_read_chapters',
            getAll() {
                try {
                    return JSON.parse(localStorage.getItem(this.storageKey)) || {};
                } catch (e) {
                    return {};
                }
            },
            isRead(slug, num) {
                const all = this.getAll();
                return !!(all[slug] && all[slug].includes(Number(num)));
            },
            markRead(slug, num) {
                num = Number(num);
                const all = this.getAll();
                if (!all[slug]) all[slug] = [];
                if (!all[slug].includes(num)) {
                    all[slug].push(num);
                    try {
                        localStorage.setItem(this.storageKey, JSON.stringify(all));
                    } catch (e) { /* localStorage غیرفعال یا پر است */ }
                }
            }
        };

        // تبدیل تاریخ شمسی (مثلا 1405/06/24) به تاریخ میلادی
        function jalaliToGregorian(jy, jm, jd) {
            let gy;
            if (jy > 979) { gy = 1600; jy -= 979; } else { gy = 621; }
            let days = (365 * jy) + (Math.floor(jy / 33) * 8) + (Math.floor(((jy % 33) + 3) / 4)) + 78 + jd + ((jm < 7) ? (jm - 1) * 31 : ((jm - 7) * 30) + 186);
            gy += 400 * Math.floor(days / 146097);
            days %= 146097;
            if (days > 36524) {
                days--;
                gy += 100 * Math.floor(days / 36524);
                days %= 36524;
                if (days >= 365) days++;
            }
            gy += 4 * Math.floor(days / 1461);
            days %= 1461;
            if (days > 365) {
                gy += Math.floor((days - 1) / 365);
                days = (days - 1) % 365;
            }
            let gd = days + 1;
            const isLeap = (gy % 4 === 0 && gy % 100 !== 0) || (gy % 400 === 0);
            const sal_a = [0, 31, isLeap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
            let gm;
            for (gm = 0; gm < 13; gm++) {
                const v = sal_a[gm];
                if (gd <= v) break;
                gd -= v;
            }
            return new Date(gy, gm - 1, gd);
        }

        // یک چپتر «جدید» است اگر کمتر از ۲ روز از بارگذاریش گذشته باشد و کاربر هنوز بازش نکرده باشد
        function isChapterNew(ep) {
            if (!ep || !ep.date) return false;
            if (ChapterReadService.isRead(MANHWA_SLUG, ep.num)) return false;
            const parts = String(ep.date).split('/').map(Number);
            if (parts.length !== 3 || parts.some(isNaN)) return false;
            const gDate = jalaliToGregorian(parts[0], parts[1], parts[2]);
            const diffDays = (Date.now() - gDate.getTime()) / 86400000;
            return diffDays >= 0 && diffDays < 2;
        }

        // بج‌های «جدید» رندرشده در سرور (۴ چپتر اول) را بر اساس وضعیت خوانده‌شدن به‌روزرسانی می‌کند

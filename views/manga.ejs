    <script src="/js/vendor/supabase.min.js"></script>
    <!-- مدال ورود/ثبت‌نام مشترک با صفحه‌ی اصلی (auth-modal.js) — باید قبل از اسکریپت اصلی بیاد -->
    <script src="/auth-modal.js?v=1"></script>
    <script src="/offline.js"></script>
    <script>
        const { createClient } = supabase;
        const db = createClient(window.location.origin, 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZ1bW51anlnc3dvdHN0dndsamF6Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODExMTkwNTIsImV4cCI6MjA5NjY5NTA1Mn0.tag4oNAsqqzYkdz6cxANpn5zJJihvk1x4RkuEd8AL0E');
        window.supabaseClient = db; // برای هماهنگی با اسکریپت مودال ورود/ثبت‌نام
        
        const MANHWA_SLUG = <%- JSON.stringify(slug).replace(/</g, '\\u003c') %>;
        let englishTitle = <%- JSON.stringify(title_en).replace(/</g, '\\u003c') %>;
        let persianTitle = <%- JSON.stringify(title_fa).replace(/</g, '\\u003c') %>;
        const SUBSCRIPTION_PAGE_URL = '/vip.html';

        // وضعیت اشتراک کاربر — بعد از هر تغییر لاگین دوباره خونده می‌شه
        let currentUserSubscribed = false;
        let subscriptionChecked = false;
        // اگه خواندن وضعیت اشتراک با خطای شبکه/دسترسی شکست بخوره، «نامعلوم» حساب می‌شه؛
        // در این حالت کاربر رو به صفحه‌ی خرید نمی‌فرستیم (سرور موقع باز کردن چپتر دقیق چک می‌کنه)
        let subscriptionUnknown = false;
        let currentProfile = null;      // { full_name, avatar_url } کاربر لاگین‌شده
        let bookmarkSyncFn = null;      // توسط setupBookmarkLogic ست می‌شه

        // قفل زمانی هر چپتر برای «همین کاربر»: { [num]: زمان باز شدن (ms) } — از /api/access/chapters (قانون در سرور است)
        // رایگان: ۲۴ ساعت اول برای بدون اشتراک | اشتراکی: ۱ روز اول برای استاندارد هفتگی
        let lockMap = {};
        let locksLoaded = false;
        async function loadChapterLocks() {
            try {
                let headers = {};
                try {
                    const { data: { session } } = await db.auth.getSession();
                    if (session && session.access_token) headers = { Authorization: 'Bearer ' + session.access_token };
                } catch (e) {}
                const r = await fetch('/api/access/chapters/' + encodeURIComponent(MANHWA_SLUG), { headers, cache: 'no-store' });
                if (!r.ok) return;
                const j = await r.json();
                const m = {};
                (j.locked || []).forEach(x => { m[x.num] = new Date(x.unlocksAt).getTime(); });
                lockMap = m;
                locksLoaded = true;
            } catch (e) { console.error('lock info:', e); }
        }
        function lockLabel(ts) {
            const h = Math.max(1, Math.ceil((ts - Date.now()) / 3600000));
            return h.toLocaleString('fa-IR') + ' ساعت تا باز شدن';
        }

        async function refreshSubscriptionStatus() {
            subscriptionChecked = false;
            subscriptionUnknown = false;
            if (!currentUser) {
                currentUserSubscribed = false;
                currentProfile = null;
                subscriptionChecked = true;
                return;
            }
            try {
                const { data, error } = await db
                    .from('profiles')
                    .select('is_vip, vip_until, full_name, avatar_url')
                    .eq('id', currentUser.id)
                    .maybeSingle();

                if (error) {
                    console.error('خطا در خواندن پروفایل:', error.message);
                    subscriptionUnknown = true;
                    currentUserSubscribed = false;
                } else if (!data) {
                    currentUserSubscribed = false;
                    currentProfile = null;
                } else {
                    const notExpired = !data.vip_until || new Date(data.vip_until) > new Date();
                    currentUserSubscribed = !!data.is_vip && notExpired;
                    currentProfile = { full_name: data.full_name, avatar_url: data.avatar_url };
                }
            } catch (err) {
                console.error('خطا در بررسی وضعیت اشتراک:', err);
                subscriptionUnknown = true;
                currentUserSubscribed = false;
            } finally {
                subscriptionChecked = true;
                await loadChapterLocks();
                // نام/آواتار واقعی پروفایل حالا در دسترسه؛ UI رو دوباره بساز
                updateAccountBtnUI();
                renderCommentAuthorArea();
                if (typeof bookmarkSyncFn === 'function') bookmarkSyncFn();
                // اگه لیست چپترها قبلاً رندر شده بود، دوباره رندرش کن تا آیکون قفل
                // برای کاربر مشترک درست به‌روز بشه
                if (typeof allEpisodes !== 'undefined' && allEpisodes.length > 0) {
                    renderEpisodes();
                }
                // برای چپترهای اولیه‌ای که سمت سرور (PHP) رندر شدن و ممکنه هنوز
                // جایگزین نشده باشن، اگه کاربر مشترکه قفل‌ها رو فوراً حذف کن
                if (currentUserSubscribed) {
                    document.querySelectorAll('#episodeList .chapter-lock-overlay').forEach(el => el.remove());
                }
            }
        }

        function escapeHtml(text) {
            if (text === null || text === undefined || text === '') return '';
            return String(text).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }

        // ==========================================

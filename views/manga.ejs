            refreshDlStates();
            const showMoreBtn = document.getElementById('showMoreBtn');
            const remaining = allEpisodes.length - visibleCount;
            if (remaining <= 0) {
                showMoreBtn.textContent = "همه قسمت‌ها نمایش داده شد";
                showMoreBtn.disabled = true;
            } else {

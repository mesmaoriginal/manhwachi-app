                        : `<span class="block text-left text-amber-400 text-sm font-medium">اشتراکی</span>`);

                const isNew = isChapterNew(ep);
                a.innerHTML = `
                    <div class="w-20 h-14 bg-zinc-800 rounded-xl overflow-hidden relative shrink-0">
                        <img src="/manhwas/${encodeURIComponent(MANHWA_SLUG)}/chapterPictures/chapterpicture${ep.num}.png" class="w-full h-full object-cover chapter-cover-img" alt="Ep ${ep.num}" onerror="this.classList.add('hidden'); this.nextElementSibling.classList.remove('hidden');">
                        <div class="chapter-cover-fallback hidden absolute inset-0 flex items-center justify-center bg-gradient-to-br from-zinc-800 to-zinc-900"><span class="text-white font-bold text-lg">#${ep.num}</span></div>
                        ${((!isFree && !currentUserSubscribed) || timeLocked) ? `<div class="chapter-lock-overlay absolute inset-0 bg-black/60 flex items-center justify-center"><span class="material-symbols-outlined text-amber-400 text-2xl">lock</span></div>` : ''}
                        ${isNew ? `<span class="new-badge">جدید</span>` : ''}
                    </div>
                    <div class="flex-1">
                        <p class="font-semibold text-white">چپتر ${ep.num}</p>
                        <p class="text-xs text-text-muted mt-1">${escapeHtml(ep.date || '')}</p>

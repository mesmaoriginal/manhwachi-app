    <script src="/js/vendor/supabase.min.js"></script>
    <!-- مدال ورود/ثبت‌نام مشترک با صفحه‌ی اصلی (auth-modal.js) — باید قبل از اسکریپت اصلی بیاد -->
    <script src="/auth-modal.js?v=1"></script>
    <script>
        const { createClient } = supabase;
        const db = createClient(window.location.origin, 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZ1bW51anlnc3dvdHN0dndsamF6Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODExMTkwNTIsImV4cCI6MjA5NjY5NTA1Mn0.tag4oNAsqqzYkdz6cxANpn5zJJihvk1x4RkuEd8AL0E');
        window.supabaseClient = db; // برای هماهنگی با اسکریپت مودال ورود/ثبت‌نام
        
        const MANHWA_SLUG = <%- JSON.stringify(slug).replace(/</g, '\\u003c') %>;
        let englishTitle = <%- JSON.stringify(title_en).replace(/</g, '\\u003c') %>;
        let persianTitle = <%- JSON.stringify(title_fa).replace(/</g, '\\u003c') %>;
        const SUBSCRIPTION_PAGE_URL = '/vip.html';

        // وضعیت اشتراک کاربر — بعد از هر تغییر لاگین دوباره خونده می‌شه
        let currentUserSubscribed = false;
        let subscriptionChecked = false;
        // اگه خواندن وضعیت اشتراک با خطای شبکه/دسترسی شکست بخوره، «نامعلوم» حساب می‌شه؛
        // در این حالت کاربر رو به صفحه‌ی خرید نمی‌فرستیم (سرور موقع باز کردن چپتر دقیق چک می‌کنه)
        let subscriptionUnknown = false;
        let currentProfile = null;      // { full_name, avatar_url } کاربر لاگین‌شده
        let bookmarkSyncFn = null;      // توسط setupBookmarkLogic ست می‌شه

        // قفل زمانی هر چپتر برای «همین کاربر»: { [num]: زمان باز شدن (ms) } — از /api/access/chapters (قانون در سرور است)
        // رایگان: ۲۴ ساعت اول برای بدون اشتراک | اشتراکی: ۱ روز اول برای استاندارد هفتگی
        let lockMap = {};
        let locksLoaded = false;
        async function loadChapterLocks() {
            try {
                let headers = {};
                try {
                    const { data: { session } } = await db.auth.getSession();
                    if (session && session.access_token) headers = { Authorization: 'Bearer ' + session.access_token };
                } catch (e) {}
                const r = await fetch('/api/access/chapters/' + encodeURIComponent(MANHWA_SLUG), { headers, cache: 'no-store' });
                if (!r.ok) return;
                const j = await r.json();
                const m = {};
                (j.locked || []).forEach(x => { m[x.num] = new Date(x.unlocksAt).getTime(); });
                lockMap = m;
                locksLoaded = true;
            } catch (e) { console.error('lock info:', e); }
        }
        function lockLabel(ts) {
            const h = Math.max(1, Math.ceil((ts - Date.now()) / 3600000));
            return h.toLocaleString('fa-IR') + ' ساعت تا باز شدن';
        }

        async function refreshSubscriptionStatus() {
            subscriptionChecked = false;
            subscriptionUnknown = false;
            if (!currentUser) {
                currentUserSubscribed = false;
                currentProfile = null;
                subscriptionChecked = true;
                return;
            }
            try {
                const { data, error } = await db
                    .from('profiles')
                    .select('is_vip, vip_until, full_name, avatar_url')
                    .eq('id', currentUser.id)
                    .maybeSingle();

                if (error) {
                    console.error('خطا در خواندن پروفایل:', error.message);
                    subscriptionUnknown = true;
                    currentUserSubscribed = false;
                } else if (!data) {
                    currentUserSubscribed = false;
                    currentProfile = null;
                } else {
                    const notExpired = !data.vip_until || new Date(data.vip_until) > new Date();
                    currentUserSubscribed = !!data.is_vip && notExpired;
                    currentProfile = { full_name: data.full_name, avatar_url: data.avatar_url };
                }
            } catch (err) {
                console.error('خطا در بررسی وضعیت اشتراک:', err);
                subscriptionUnknown = true;
                currentUserSubscribed = false;
            } finally {
                subscriptionChecked = true;
                await loadChapterLocks();
                // نام/آواتار واقعی پروفایل حالا در دسترسه؛ UI رو دوباره بساز
                updateAccountBtnUI();
                renderCommentAuthorArea();
                if (typeof bookmarkSyncFn === 'function') bookmarkSyncFn();
                // اگه لیست چپترها قبلاً رندر شده بود، دوباره رندرش کن تا آیکون قفل
                // برای کاربر مشترک درست به‌روز بشه
                if (typeof allEpisodes !== 'undefined' && allEpisodes.length > 0) {
                    renderEpisodes();
                }
                // برای چپترهای اولیه‌ای که سمت سرور (PHP) رندر شدن و ممکنه هنوز
                // جایگزین نشده باشن، اگه کاربر مشترکه قفل‌ها رو فوراً حذف کن
                if (currentUserSubscribed) {
                    document.querySelectorAll('#episodeList .chapter-lock-overlay').forEach(el => el.remove());
                }
            }
        }

        function escapeHtml(text) {
            if (text === null || text === undefined || text === '') return '';
            return String(text).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }

        // ==========================================
        // Auth (login/signup) — comments now require an account
        // ==========================================
        let currentUser = null;

        // اولویت: نام پروفایل > full_name ثبت‌نام > display_name > بخش اول ایمیل
        // (ثبت‌نام full_name رو ذخیره می‌کنه، نه display_name؛ قبلاً همیشه بخش اول ایمیل نشون داده می‌شد)
        function getDisplayName(user) {
            if (!user) return '';
            return (currentProfile?.full_name || '').trim()
                || user.user_metadata?.full_name
                || user.user_metadata?.display_name
                || (user.email ? user.email.split('@')[0] : 'کاربر');
        }

        // فقط آدرس http(s) قبول می‌شه و کاراکترهای خطرناک attribute کدگذاری می‌شن
        function safeAvatarUrl(url) {
            if (typeof url !== 'string' || !url.trim()) return '';
            try {
                const u = new URL(url.trim());
                if (u.protocol !== 'https:' && u.protocol !== 'http:') return '';
                return u.href.replace(/"/g, '%22').replace(/'/g, '%27').replace(/</g, '%3C').replace(/>/g, '%3E');
            } catch (e) {
                return '';
            }
        }

        // آواتار: اگه عکس داشت نشونش می‌ده، وگرنه (یا اگه عکس لود نشد) حرف اول اسم
        function avatarHtml(name, avatarUrl, opts = {}) {
            const { size = 'w-12 h-12', text = 'text-2xl', radius = 'rounded-2xl', extra = '' } = opts;
            const url = safeAvatarUrl(avatarUrl);
            const initial = escapeHtml(Array.from(String(name || '?'))[0] || '?');
            const base = `${size} ${radius} ${extra} relative overflow-hidden flex items-center justify-center flex-shrink-0 bg-gradient-to-br from-red-500 to-rose-600`;
            const fallback = `<span class="text-white font-bold ${text}">${initial}</span>`;
            if (!url) return `<div class="${base}">${fallback}</div>`;
            return `<div class="${base}">${fallback}<img src="${url}" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" class="absolute inset-0 w-full h-full object-cover bg-zinc-900" onload="this.previousElementSibling.style.display='none'" onerror="this.remove()"></div>`;
        }


        function renderCommentAuthorArea() {
            const area = document.getElementById('commentAuthorArea');
            if (!area) return;
            if (currentUser) {
                const name = getDisplayName(currentUser);
                area.innerHTML = `
                    <div class="flex items-center justify-between bg-surface-container rounded-2xl px-5 py-3.5 border border-white/10">
                        <div class="flex items-center gap-3">
                            ${avatarHtml(name, currentProfile?.avatar_url, { size: 'w-9 h-9', text: 'text-sm', radius: 'rounded-xl' })}
                            <span class="text-sm text-on-surface">نظر با نام <span class="font-bold text-white">${escapeHtml(name)}</span> ثبت می‌شه</span>
                        </div>
                    </div>`;
            } else {
                area.innerHTML = `
                    <button type="button" id="promptLoginBtn" class="w-full flex items-center justify-center gap-2 bg-surface-container border border-dashed border-white/15 rounded-2xl px-5 py-4 text-sm text-on-surface-variant hover:border-primary/50 hover:text-primary transition-all">
                        <span class="material-symbols-outlined text-lg">login</span>
                        برای ثبت نظر وارد حساب شو یا ثبت‌نام کن
                    </button>`;
                document.getElementById('promptLoginBtn')?.addEventListener('click', () => { openAuthModal('login'); });
            }
        }

        function updateAccountBtnUI() {
            const icon = document.getElementById('accountBtnIcon');
            const nameSpan = document.getElementById('accountBtnName');
            const btn = document.getElementById('accountBtn');
            if (!icon || !btn || !nameSpan) return;
            if (currentUser) {
                const name = getDisplayName(currentUser);
                icon.textContent = 'account_circle';
                icon.classList.add('text-primary');
                nameSpan.textContent = name;
                nameSpan.classList.remove('hidden');
                btn.classList.add('border-primary/40');
                btn.title = name + ' — مشاهده پروفایل';
            } else {
                icon.textContent = 'person';
                icon.classList.remove('text-primary');
                nameSpan.textContent = '';
                nameSpan.classList.add('hidden');
                btn.classList.remove('border-primary/40');
                btn.title = 'ورود به حساب';
            }
        }

        document.getElementById('accountBtn').addEventListener('click', () => {
            if (currentUser) {
                window.location.href = '/?page=profile';
            } else {
                openAuthModal('login');
            }
        });

        db.auth.onAuthStateChange((_event, session) => {
            currentUser = session?.user || null;
            updateAccountBtnUI();
            renderCommentAuthorArea();
            refreshSubscriptionStatus();
        });

        (async () => {
            const { data: { session } } = await db.auth.getSession();
            currentUser = session?.user || null;
            updateAccountBtnUI();
            renderCommentAuthorArea();
            await refreshSubscriptionStatus();
        })();

        let allEpisodes = [];
        let visibleCount = 4;
        let renderedCount = 4; // چپترهای رندرشده در سرور؛ فقط چپترهای تازه‌اضافه‌شده انیمیشن می‌گیرند
        let isNewestFirst = true;

        // ===== سرویس ذخیره‌سازی وضعیت «خوانده‌شده» چپترها (برای برداشتن نشان «جدید») =====
        const ChapterReadService = {
            storageKey: 'manhwachi_read_chapters',
            getAll() {
                try {
                    return JSON.parse(localStorage.getItem(this.storageKey)) || {};
                } catch (e) {
                    return {};
                }
            },
            isRead(slug, num) {
                const all = this.getAll();
                return !!(all[slug] && all[slug].includes(Number(num)));
            },
            markRead(slug, num) {
                num = Number(num);
                const all = this.getAll();
                if (!all[slug]) all[slug] = [];
                if (!all[slug].includes(num)) {
                    all[slug].push(num);
                    try {
                        localStorage.setItem(this.storageKey, JSON.stringify(all));
                    } catch (e) { /* localStorage غیرفعال یا پر است */ }
                }
            }
        };

        // تبدیل تاریخ شمسی (مثلا 1405/06/24) به تاریخ میلادی
        function jalaliToGregorian(jy, jm, jd) {
            let gy;
            if (jy > 979) { gy = 1600; jy -= 979; } else { gy = 621; }
            let days = (365 * jy) + (Math.floor(jy / 33) * 8) + (Math.floor(((jy % 33) + 3) / 4)) + 78 + jd + ((jm < 7) ? (jm - 1) * 31 : ((jm - 7) * 30) + 186);
            gy += 400 * Math.floor(days / 146097);
            days %= 146097;
            if (days > 36524) {
                days--;
                gy += 100 * Math.floor(days / 36524);
                days %= 36524;
                if (days >= 365) days++;
            }
            gy += 4 * Math.floor(days / 1461);
            days %= 1461;
            if (days > 365) {
                gy += Math.floor((days - 1) / 365);
                days = (days - 1) % 365;
            }
            let gd = days + 1;
            const isLeap = (gy % 4 === 0 && gy % 100 !== 0) || (gy % 400 === 0);
            const sal_a = [0, 31, isLeap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
            let gm;
            for (gm = 0; gm < 13; gm++) {
                const v = sal_a[gm];
                if (gd <= v) break;
                gd -= v;
            }
            return new Date(gy, gm - 1, gd);
        }

        // یک چپتر «جدید» است اگر کمتر از ۲ روز از بارگذاریش گذشته باشد و کاربر هنوز بازش نکرده باشد
        function isChapterNew(ep) {
            if (!ep || !ep.date) return false;
            if (ChapterReadService.isRead(MANHWA_SLUG, ep.num)) return false;
            const parts = String(ep.date).split('/').map(Number);
            if (parts.length !== 3 || parts.some(isNaN)) return false;
            const gDate = jalaliToGregorian(parts[0], parts[1], parts[2]);
            const diffDays = (Date.now() - gDate.getTime()) / 86400000;
            return diffDays >= 0 && diffDays < 2;
        }

        // بج‌های «جدید» رندرشده در سرور (۴ چپتر اول) را بر اساس وضعیت خوانده‌شدن به‌روزرسانی می‌کند
        function refreshInitialNewBadges() {
            document.querySelectorAll('#episodeList a[data-num]').forEach(a => {
                const badge = a.querySelector('.new-badge');
                if (badge && ChapterReadService.isRead(MANHWA_SLUG, a.dataset.num)) {
                    badge.remove();
                }
            });
        }

        let currentCommentPage = 1;
        const commentsPerPage = 5;
        let globalMainMessages = [];
        let globalUserReplies = [];
        let globalAdminReplies = [];
        let globalProfilesMap = {}; // user_id -> { name, avatar }

        function getCommentAuthorName(msg) {
            const p = msg && msg.user_id && globalProfilesMap[msg.user_id];
            if (p && p.name) return p.name;
            return (msg && msg.name) || 'کاربر';
        }

        function getCommentAuthorAvatar(msg) {
            const p = msg && msg.user_id && globalProfilesMap[msg.user_id];
            return p ? p.avatar : '';
        }

        async function loadDynamicContent() {
            try {
                const res = await fetch(`/data/data.json?v=${Date.now()}`);
                const data = await res.json();
                const manhwa = data[MANHWA_SLUG];

                if (!manhwa) return;

                englishTitle = manhwa.title_en;
                persianTitle = manhwa.title_fa;
                allEpisodes = manhwa.episodes || [];

                renderSimilarManhwas(data, MANHWA_SLUG, manhwa.genres || []);
                if (!locksLoaded) await loadChapterLocks();
                renderEpisodes();
            } catch (err) {
                console.error("خطا در بارگذاری دیتای داینامیک:", err);
            }
        }

        function renderEpisodes() {
            const container = document.getElementById('episodeList');
            container.innerHTML = '';

            const subBanner = document.getElementById('subscriptionBanner');
            if (subBanner) {
                const hasLocked = allEpisodes.some(ep => !ep.free);
                subBanner.classList.toggle('hidden', !hasLocked);
                subBanner.classList.toggle('flex', hasLocked);
            }

            // همیشه بر اساس شماره‌ی چپتر مرتب می‌شه (نه ترتیب فایل data.json)
            let sortedEpisodes = [...allEpisodes].sort((a, b) => Number(b.num) - Number(a.num));
            if (!isNewestFirst) sortedEpisodes.reverse();

            const visibleEpisodes = sortedEpisodes.slice(0, visibleCount);
            visibleEpisodes.forEach((ep, idx) => {
                const a = document.createElement('a');
                let isFree = ep.free;
                a.href = `/reader.html?slug=${encodeURIComponent(MANHWA_SLUG)}&ch=${encodeURIComponent(ep.num)}`;
                a.dataset.free = isFree ? '1' : '0';
                a.dataset.num = ep.num;

                a.className = 'mx-ep episode-card' + (idx >= renderedCount ? ' mx-enter' : '');
                if (idx >= renderedCount) a.style.animationDelay = Math.min((idx - renderedCount) * 45, 600) + 'ms';
                const lockAt = lockMap[ep.num] || 0;
                const timeLocked = lockAt > Date.now();
                let statusHTML = timeLocked
                    ? `<span class="lock-pill"><span class="material-symbols-outlined">schedule</span>${lockLabel(lockAt)}</span>`
                    : `<span class="mx-st ${isFree ? 'free' : 'paid'}">${isFree ? 'رایگان' : 'اشتراکی'}</span>`;

                const isNew = isChapterNew(ep);
                a.innerHTML = `
                    <div class="mx-thumb">
                        <img src="/manhwas/${encodeURIComponent(MANHWA_SLUG)}/chapterPictures/chapterpicture${ep.num}.png" class="chapter-cover-img" alt="Ep ${ep.num}" onerror="this.classList.add('hidden'); this.nextElementSibling.classList.remove('hidden');">
                        <div class="chapter-cover-fallback hidden">#${ep.num}</div>
                        ${((!isFree && !currentUserSubscribed) || timeLocked) ? `<div class="mx-lock chapter-lock-overlay"><span class="material-symbols-outlined">lock</span></div>` : ''}
                        ${isNew ? `<span class="new-badge">جدید</span>` : ''}
                    </div>
                    <div class="mx-ep-b"><p class="mx-ep-t">چپتر ${ep.num}</p><p class="mx-ep-d">${escapeHtml(ep.date || '')}</p></div>
                    ${statusHTML}
                `;
                container.appendChild(a);
            });

            renderedCount = visibleEpisodes.length;

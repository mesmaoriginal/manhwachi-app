<!DOCTYPE html>
<html class="dark" lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta name="robots" content="index, follow, max-image-preview:large">

    <!-- SEO Meta Tags -->
    <title><%= seo_title %></title>
    <meta name="description" content="<%= seo_desc %>">
    <link rel="canonical" href="<%= canonical_url %>" />

    <!-- Open Graph / Facebook / Telegram -->
    <meta property="og:type" content="book" />
    <meta property="og:site_name" content="مانهواچی" />
    <meta property="og:title" content="<%= seo_title %>" />
    <meta property="og:description" content="<%= seo_desc %>" />
    <meta property="og:image" content="<%= full_cover_url %>" />
    <meta property="og:url" content="<%= canonical_url %>" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="<%= seo_title %>" />
    <meta name="twitter:description" content="<%= seo_desc %>" />
    <meta name="twitter:image" content="<%= full_cover_url %>" />

    <!-- Favicons -->
    <link rel="icon" href="/ManhwaChi/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/ManhwaChi/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/ManhwaChi/favicon-192x192.png" />
    <link rel="apple-touch-icon" href="/ManhwaChi/apple-touch-icon.png" />

    <!-- Google Structured Data (Schema.org) for SEO Rich Snippets -->
    <% if (manhwa) { %>
    <script type="application/ld+json">
    <%- JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Book",
      "name": title_en,
      "alternateName": title_fa,
      "description": raw_desc,
      "image": full_cover_url,
      "url": canonical_url,
      "inLanguage": "fa",
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": String(score),
        "bestRating": "10",
        "worstRating": "1",
        "ratingCount": "100"
      }
    }) %>
    </script>
    <% } %>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-18XD50KTY3"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-18XD50KTY3');
    </script>
    
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@700;800&display=swap" rel="stylesheet">
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        primary: "#DC2626",
                        "on-primary": "#ffff",
                        surface: "#000000",
                        "surface-elevated": "#161616",
                        "surface-shadow":"#241717 ",
                        "surface-container": "#1f1f1f",
                        "on-surface": "#e2e2e2",
                        "on-surface-variant": "#cbb8b8",
                        "text-muted": "#8C8C8C",
                    }
                }
            }
        }
    </script>

    <style>
        .glass-scrim {
            background: linear-gradient(to top, #000000 10%, rgba(0, 0, 0, 0.7) 50%, transparent 100%);
        }
        .text-shadow-glow {
            text-shadow: 0 0 20px rgb(220 38 38 / var(--tw-bg-opacity, 1));
        }
        .episode-card {
            transition: all 0.3s ease;
        }
        .episode-card:hover {
            transform: translateX(-10px);
            background-color: #2a2a2a;
        }
        @media (min-width: 1024px) {
            .text-shadow-glow { text-shadow: none; }
            .episode-card:hover { transform: translateY(-4px); background-color: #2a2a2a; }
        }
        .border-white {
            --tw-border-opacity: 1;
            border-color: rgb(255 255 255 / 27%);
        }
        .manhwa-card {
            position: relative;
            overflow: hidden;
        }
        .manhwa-card::before {
            content: "";
            position: absolute;
            width: 450px;
            height: 450px;
            background: #dc2626;
            opacity: 0.15;
            filter: blur(120px);
            top: -220px;
            left: 50%;
            transform: translateX(-50%);
            pointer-events: none;
        }
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #1f1f1f; }
        ::-webkit-scrollbar-thumb { background: rgb(220 38 38 / var(--tw-bg-opacity, 1)); border-radius: 10px; }

        .reply-box { margin-top:12px; padding:16px; background:#1f1f1f; border-radius:16px; border:1px solid rgba(255,255,255,0.08); }
        .reply-thread {
            border-right: 3px solid rgba(255, 255, 255, 0.08);
            margin-right: 8px;
            padding-right: 14px;
            background: rgba(255, 255, 255, 0.015);
            padding-top: 8px;
            padding-bottom: 8px;
            border-radius: 0 12px 12px 0;
            transition: all 0.2s ease;
        }
        .reply-thread:hover {
            border-right-color: rgba(220, 38, 38, 0.5);
            background: rgba(255, 255, 255, 0.03);
        }

        .admin-reply {
            background: linear-gradient(135deg, rgba(220, 38, 38, 0.08) 0%, rgba(0, 0, 0, 0.3) 100%);
            border: 1px solid rgba(220, 38, 38, 0.25);
            border-right: 3px solid #DC2626;
            border-radius: 16px;
            padding: 14px 16px;
            box-shadow: 0 4px 20px rgba(220, 38, 38, 0.05);
        }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .comment-animate { animation: fadeIn 0.5s cubic-bezier(0.4, 0, 0.2, 1); }

        .description-text { max-height: 132px; }
        .description-text.expanded { max-height: 2000px; }
        .description-fade.hidden-fade { opacity: 0; }
        #descriptionToggleBtn.flex-visible { display: flex; }

        .telegram-banner{
            margin:28px 0;
            padding:0 18px;
        }
        .telegram-banner-link{
            display:flex;
            align-items:center;
            justify-content:space-between;
            gap:16px;
            width:100%;
            padding:18px 22px;
            border-radius:22px;
            text-decoration:none;
            color:#fff;
            background:linear-gradient(135deg,#229ED9,#1668c7);
            box-shadow: 0 12px 35px rgba(34,158,217,.28), inset 0 1px rgba(255,255,255,.15);
            position:relative;
            overflow:hidden;
        }
        .telegram-banner-link::before{
            content:"";
            position:absolute;
            top:-70px;
            right:-40px;
            width:180px;
            height:180px;
            background:rgba(255,255,255,.12);
            border-radius:50%;
        }
        #copyTelegramBtn {
            border:none;
            cursor:pointer;
            font-family:inherit;
        }
        .telegram-icon{
            width:64px;
            height:64px;
            flex-shrink:0;
            border-radius:50%;
            background:rgba(255,255,255,.15);
            display:flex;
            justify-content:center;
            align-items:center;
            backdrop-filter:blur(8px);
        }
        .telegram-icon img{ width:38px; height:38px; }
        .telegram-content{ flex:1; margin:0 10px; }
        .telegram-title{ font-size:17px; font-weight:700; margin-bottom:5px; }
        .telegram-subtitle{ font-size:14px; opacity:.95; }
        .telegram-btn{
            background:#fff;
            color:#1b84d6;
            padding:12px 22px;
            border-radius:14px;
            font-weight:700;
            transition:.25s;
            white-space:nowrap;
        }
        .telegram-banner-link:hover .telegram-btn{ transform:scale(1.06); }
        
        @media(max-width:700px){
            .telegram-banner-link{ padding:16px; }
            .telegram-icon{ width:52px; height:52px; }
            .telegram-icon img{ width:30px; height:30px; }
            .telegram-title{ font-size:15px; }
            .telegram-subtitle{ font-size:13px; }
            .telegram-btn{ padding:10px 16px; font-size:13px; }
        }

        #mobile-drawer { transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1); }
        #drawer-overlay { transition: opacity 0.3s ease, visibility 0.3s ease; }
        .drawer-open #mobile-drawer { transform: translateX(0) !important; }
        .drawer-open #drawer-overlay { opacity: 1 !important; visibility: visible !important; pointer-events: auto !important; }
        .drawer-item { transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1); }
        .drawer-item:hover {
            background: rgba(220, 38, 38, 0.12);
            border-color: rgba(220, 38, 38, 0.3);
            transform: translateX(-4px);
        }
        .nav-link { position: relative; }
        .nav-link::after {
            content: '';
            position: absolute;
            bottom: -4px;
            right: 0;
            width: 0;
            height: 2px;
            background-color: #DC2626;
            transition: width 0.3s ease;
        }
        .nav-link:hover::after { width: 100%; }

        .scrollbar-none::-webkit-scrollbar { display: none; }
        .scrollbar-none { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>

<body class="bg-surface text-on-surface font-body min-h-screen">

    <div id="successModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm flex items-center justify-center p-5 z-[999] opacity-0 pointer-events-none transition-all duration-300">
        <div class="relative bg-surface-elevated rounded-3xl p-8 max-w-md w-full border border-white/10 overflow-hidden">
            <div class="absolute -top-20 left-1/2 -translate-x-1/2 w-72 h-72 bg-primary/20 blur-[100px]"></div>
            <div class="relative z-10 text-center">
                <div class="w-20 h-20 mx-auto mb-5 rounded-full bg-green-500/15 flex items-center justify-center"><span class="material-symbols-outlined text-green-400 text-5xl">check_circle</span></div>
                <h3 class="text-2xl font-bold mb-3">نظر ثبت شد</h3>
                <p class="text-on-surface-variant leading-relaxed mb-6">نظر شما با موفقیت ارسال شد و پس از بررسی توسط مدیریت در بخش نظرات نمایش داده خواهد شد.</p>
                <button id="closeSuccessModal" class="w-full h-12 bg-primary rounded-2xl font-semibold hover:opacity-90 transition">متوجه شدم</button>
            </div>
        </div>
    </div>

<!-- Auth Modal Animations -->
<style>
  @keyframes authBackdropIn { from { opacity: 0; } to { opacity: 1; } }
  @keyframes authCardIn {
    from { opacity: 0; transform: scale(.92) translateY(14px); }
    to   { opacity: 1; transform: scale(1) translateY(0); }
  }
  @keyframes authMsgIn {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes authGlow {
    0%, 100% { opacity: .55; }
    50%      { opacity: 1; }
  }
  #authModal.flex { animation: authBackdropIn .25s ease-out; }
  #authModal.flex .auth-card { animation: authCardIn .4s cubic-bezier(.16,1,.3,1); }
  .authMsg-in { animation: authMsgIn .3s ease-out; }
  .auth-card { scrollbar-width: none; -ms-overflow-style: none; }
  .auth-card::-webkit-scrollbar { display: none; }
  .auth-orb { animation: authGlow 3.5s ease-in-out infinite; }
  .auth-icon-input:focus ~ .auth-input-icon { color: #ef4444; }
</style>

<!-- Modal Container -->
<div id="authModal" class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/85 backdrop-blur-md p-4 transition-all duration-300">

  <div class="auth-card relative w-full max-w-md max-h-[92vh] overflow-y-auto rounded-[28px] bg-gradient-to-b from-zinc-900 to-black border border-zinc-800/80 shadow-[0_25px_70px_-15px_rgba(220,38,38,0.35)] text-zinc-100 font-sans dir-rtl text-right">

    <!-- نوار تزئینی بالای مودال -->
    <div class="h-1.5 w-full bg-gradient-to-l from-red-700 via-red-500 to-red-700 rounded-t-[28px]"></div>

    <!-- دکمه بستن -->
    <button onclick="closeAuthModal()" aria-label="بستن" class="absolute top-4 left-4 w-8 h-8 flex items-center justify-center rounded-full bg-zinc-800/60 text-zinc-400 hover:text-white hover:bg-zinc-700/80 active:scale-90 transition-all z-10">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <div class="p-6 pt-7">

      <!-- برند / لوگو -->
      <div class="flex flex-col items-center text-center mb-6">
        <div class="relative mb-3">
          <div class="auth-orb absolute inset-0 rounded-2xl bg-red-600/40 blur-xl"></div>
          <div class="relative w-14 h-14 rounded-2xl bg-zinc-800/80 border border-red-500/30 flex items-center justify-center overflow-hidden">
            <img src="ManhwaChi/LOGO-main-white.webp" alt="ManhwaChi" class="w-8 h-8 object-contain" />
          </div>
        </div>
        <h2 class="font-bold text-lg text-white font-['Montserrat']">Manhwa<span class="text-red-600">Chi</span></h2>
        <p id="authSubtitle" class="text-xs text-zinc-400 mt-1">خوش برگشتی! برای ادامه وارد حساب خود شو</p>
      </div>

      <!-- تب‌ها (سگمنت شیشه‌ای) -->
      <div class="flex items-center gap-1 bg-zinc-800/50 rounded-full p-1 mb-5 border border-zinc-700/40">
        <button id="tabLoginBtn" type="button" onclick="switchAuthTab('login')" class="flex-1 py-2.5 rounded-full text-xs sm:text-sm font-bold transition-all duration-300 bg-gradient-to-r from-red-600 to-red-700 text-white shadow-lg shadow-red-950/40">
          ورود
        </button>
        <button id="tabRegisterBtn" type="button" onclick="switchAuthTab('register')" class="flex-1 py-2.5 rounded-full text-xs sm:text-sm font-bold transition-all duration-300 text-zinc-400 hover:text-zinc-200">
          عضویت جدید
        </button>
      </div>

      <!-- باکس نمایش پیام‌ها -->
      <div id="authMessage" class="hidden mb-4 p-3.5 rounded-xl text-xs flex items-start gap-2.5 transition-all duration-300"></div>

      <!-- ==================== فرم ورود ==================== -->
      <form id="loginForm" onsubmit="handleLogin(event)" class="space-y-4">
        <div>
          <label for="loginEmail" class="block text-xs font-medium text-zinc-400 mb-1.5">ایمیل</label>
          <div class="relative">
            <i class="fa-solid fa-envelope auth-input-icon absolute top-1/2 -translate-y-1/2 right-4 text-zinc-500 text-sm transition-colors pointer-events-none"></i>
            <input type="email" id="loginEmail" required placeholder="example@gmail.com" class="auth-icon-input w-full rounded-xl bg-zinc-800/60 border border-zinc-700/50 pr-11 pl-4 py-2.5 text-sm text-white placeholder-zinc-500 focus:border-red-500 focus:ring-1 focus:ring-red-500/50 focus:outline-none transition-all" />
          </div>
        </div>
        <div>
          <label for="loginPassword" class="block text-xs font-medium text-zinc-400 mb-1.5">رمز عبور</label>
          <div class="relative">
            <i class="fa-solid fa-lock auth-input-icon absolute top-1/2 -translate-y-1/2 right-4 text-zinc-500 text-sm transition-colors pointer-events-none"></i>
            <input type="password" id="loginPassword" required placeholder="••••••••" class="auth-icon-input w-full rounded-xl bg-zinc-800/60 border border-zinc-700/50 pr-11 pl-11 py-2.5 text-sm text-white placeholder-zinc-500 focus:border-red-500 focus:ring-1 focus:ring-red-500/50 focus:outline-none transition-all" />
            <button type="button" onclick="toggleAuthPassword('loginPassword', this)" tabindex="-1" aria-label="نمایش رمز عبور" class="absolute top-1/2 -translate-y-1/2 left-3.5 text-zinc-500 hover:text-zinc-300 transition-colors">
              <i class="fa-solid fa-eye text-sm"></i>
            </button>
          </div>
          <div class="text-left mt-1.5">
            <button type="button" onclick="showForgotPasswordForm()" class="text-xs text-red-500 hover:text-red-400 transition-all">
              رمز عبور را فراموش کرده‌اید؟
            </button>
          </div>
        </div>

        <button type="submit" id="loginSubmitBtn" class="w-full py-3 mt-2 rounded-xl bg-gradient-to-r from-red-600 to-red-700 hover:from-red-500 hover:to-red-600 font-bold text-sm text-white shadow-lg shadow-red-950/40 active:scale-[0.98] transition-all flex items-center justify-center gap-2">
          <i class="fa-solid fa-right-to-bracket text-xs"></i>
          ورود به حساب
        </button>
      </form>

      <!-- ==================== فرم فراموشی رمز عبور ==================== -->
      <form id="forgotPasswordForm" onsubmit="handleForgotPassword(event)" class="space-y-4 hidden">
        <div class="text-center mb-1">
          <p class="text-xs text-zinc-300">ایمیل حساب خود را وارد کنید تا لینک بازیابی رمز عبور برایتان ارسال شود.</p>
        </div>
        <div>
          <label for="forgotEmail" class="block text-xs font-medium text-zinc-400 mb-1.5">ایمیل</label>
          <div class="relative">
            <i class="fa-solid fa-envelope auth-input-icon absolute top-1/2 -translate-y-1/2 right-4 text-zinc-500 text-sm transition-colors pointer-events-none"></i>
            <input type="email" id="forgotEmail" required placeholder="example@gmail.com" class="auth-icon-input w-full rounded-xl bg-zinc-800/60 border border-zinc-700/50 pr-11 pl-4 py-2.5 text-sm text-white placeholder-zinc-500 focus:border-red-500 focus:ring-1 focus:ring-red-500/50 focus:outline-none transition-all" />
          </div>
        </div>
        <button type="submit" id="forgotSubmitBtn" class="w-full py-3 mt-2 rounded-xl bg-gradient-to-r from-red-600 to-red-700 hover:from-red-500 hover:to-red-600 font-bold text-sm text-white shadow-lg shadow-red-950/40 active:scale-[0.98] transition-all">
          ارسال لینک بازیابی رمز عبور
        </button>
        <div class="text-center">
          <button type="button" onclick="switchAuthTab('login')" class="text-xs text-zinc-400 hover:text-zinc-200 transition-all">
            بازگشت به ورود
          </button>
        </div>
      </form>

      <!-- ==================== فرم تنظیم رمز عبور جدید ==================== -->
      <form id="resetPasswordForm" onsubmit="handleResetPassword(event)" class="space-y-4 hidden">
        <div class="text-center mb-1">
          <p class="text-xs text-zinc-300">رمز عبور جدید خود را وارد کنید.</p>
        </div>
        <div>
          <label for="resetNewPassword" class="block text-xs font-medium text-zinc-400 mb-1.5">رمز عبور جدید (حداقل ۶ کاراکتر)</label>
          <div class="relative">
            <i class="fa-solid fa-lock auth-input-icon absolute top-1/2 -translate-y-1/2 right-4 text-zinc-500 text-sm transition-colors pointer-events-none"></i>
            <input type="password" id="resetNewPassword" minlength="6" required placeholder="••••••••" class="auth-icon-input w-full rounded-xl bg-zinc-800/60 border border-zinc-700/50 pr-11 pl-11 py-2.5 text-sm text-white placeholder-zinc-500 focus:border-red-500 focus:ring-1 focus:ring-red-500/50 focus:outline-none transition-all" />
            <button type="button" onclick="toggleAuthPassword('resetNewPassword', this)" tabindex="-1" aria-label="نمایش رمز عبور" class="absolute top-1/2 -translate-y-1/2 left-3.5 text-zinc-500 hover:text-zinc-300 transition-colors">
              <i class="fa-solid fa-eye text-sm"></i>
            </button>
          </div>
        </div>
        <div>
          <label for="resetConfirmPassword" class="block text-xs font-medium text-zinc-400 mb-1.5">تکرار رمز عبور جدید</label>
          <div class="relative">
            <i class="fa-solid fa-lock auth-input-icon absolute top-1/2 -translate-y-1/2 right-4 text-zinc-500 text-sm transition-colors pointer-events-none"></i>
            <input type="password" id="resetConfirmPassword" minlength="6" required placeholder="••••••••" class="auth-icon-input w-full rounded-xl bg-zinc-800/60 border border-zinc-700/50 pr-11 pl-4 py-2.5 text-sm text-white placeholder-zinc-500 focus:border-red-500 focus:ring-1 focus:ring-red-500/50 focus:outline-none transition-all" />
          </div>
        </div>
        <button type="submit" id="resetSubmitBtn" class="w-full py-3 mt-2 rounded-xl bg-gradient-to-r from-red-600 to-red-700 hover:from-red-500 hover:to-red-600 font-bold text-sm text-white shadow-lg shadow-red-950/40 active:scale-[0.98] transition-all">
          ثبت رمز عبور جدید
        </button>
      </form>

      <!-- ==================== فرم ثبت‌نام ==================== -->
      <form id="registerForm" onsubmit="handleRegister(event)" class="space-y-3.5 hidden">
        <div>
          <label for="regFullName" class="block text-xs font-medium text-zinc-400 mb-1">نام و نام خانوادگی</label>
          <div class="relative">
            <i class="fa-solid fa-user auth-input-icon absolute top-1/2 -translate-y-1/2 right-4 text-zinc-500 text-sm transition-colors pointer-events-none"></i>
            <input type="text" id="regFullName" required placeholder="مثال: علی محمدی" class="auth-icon-input w-full rounded-xl bg-zinc-800/60 border border-zinc-700/50 pr-11 pl-4 py-2.5 text-sm text-white placeholder-zinc-500 focus:border-red-500 focus:ring-1 focus:ring-red-500/50 focus:outline-none transition-all" />
          </div>
        </div>

        <div>
          <label for="regEmail" class="block text-xs font-medium text-zinc-400 mb-1">جیمیل (فقط Google Gmail)</label>
          <div class="relative">
            <i class="fa-solid fa-envelope auth-input-icon absolute top-1/2 -translate-y-1/2 right-4 text-zinc-500 text-sm transition-colors pointer-events-none"></i>
            <input type="email" id="regEmail" required placeholder="example@gmail.com" class="auth-icon-input w-full rounded-xl bg-zinc-800/60 border border-zinc-700/50 pr-11 pl-4 py-2.5 text-sm text-white placeholder-zinc-500 focus:border-red-500 focus:ring-1 focus:ring-red-500/50 focus:outline-none transition-all" />
          </div>
        </div>

        <div>
          <label for="regPassword" class="block text-xs font-medium text-zinc-400 mb-1">رمز عبور (حداقل ۶ کاراکتر)</label>
          <div class="relative">
            <i class="fa-solid fa-lock auth-input-icon absolute top-1/2 -translate-y-1/2 right-4 text-zinc-500 text-sm transition-colors pointer-events-none"></i>
            <input type="password" id="regPassword" oninput="checkPasswordStrength(this.value)" minlength="6" required placeholder="••••••••" class="auth-icon-input w-full rounded-xl bg-zinc-800/60 border border-zinc-700/50 pr-11 pl-11 py-2.5 text-sm text-white placeholder-zinc-500 focus:border-red-500 focus:ring-1 focus:ring-red-500/50 focus:outline-none transition-all" />
            <button type="button" onclick="toggleAuthPassword('regPassword', this)" tabindex="-1" aria-label="نمایش رمز عبور" class="absolute top-1/2 -translate-y-1/2 left-3.5 text-zinc-500 hover:text-zinc-300 transition-colors">
              <i class="fa-solid fa-eye text-sm"></i>
            </button>
          </div>

          <!-- نوار سنجش قدرت رمز عبور -->
          <div class="mt-2">
            <div class="w-full bg-zinc-800 h-1 rounded-full overflow-hidden">
              <div id="passwordStrengthBar" class="h-1 rounded-full bg-zinc-700 transition-all duration-300 w-0"></div>
            </div>
            <div id="passwordStrengthText"></div>
          </div>
        </div>

        <div>
          <label for="regConfirmPassword" class="block text-xs font-medium text-zinc-400 mb-1">تکرار رمز عبور</label>
          <div class="relative">
            <i class="fa-solid fa-lock auth-input-icon absolute top-1/2 -translate-y-1/2 right-4 text-zinc-500 text-sm transition-colors pointer-events-none"></i>
            <input type="password" id="regConfirmPassword" minlength="6" required placeholder="••••••••" class="auth-icon-input w-full rounded-xl bg-zinc-800/60 border border-zinc-700/50 pr-11 pl-11 py-2.5 text-sm text-white placeholder-zinc-500 focus:border-red-500 focus:ring-1 focus:ring-red-500/50 focus:outline-none transition-all" />
            <button type="button" onclick="toggleAuthPassword('regConfirmPassword', this)" tabindex="-1" aria-label="نمایش رمز عبور" class="absolute top-1/2 -translate-y-1/2 left-3.5 text-zinc-500 hover:text-zinc-300 transition-colors">
              <i class="fa-solid fa-eye text-sm"></i>
            </button>
          </div>
        </div>

        <button type="submit" id="regSubmitBtn" class="w-full py-3 mt-2 rounded-xl bg-gradient-to-r from-red-600 to-red-700 hover:from-red-500 hover:to-red-600 font-bold text-sm text-white shadow-lg shadow-red-950/40 active:scale-[0.98] transition-all flex items-center justify-center gap-2">
          <i class="fa-solid fa-paper-plane text-xs"></i>
          ارسال کد تایید به جیمیل
        </button>
        <p class="text-[11px] text-zinc-500 text-center leading-5">با ثبت‌نام، قوانین و حریم خصوصی مانهواچی را می‌پذیرید.</p>
      </form>

      <!-- ==================== فرم ورود کد OTP ==================== -->
      <form id="otpForm" onsubmit="handleVerifyOTP(event)" class="space-y-4 hidden">
        <div class="text-center mb-2 flex flex-col items-center gap-2">
          <div class="w-12 h-12 rounded-full bg-red-600/10 border border-red-500/30 flex items-center justify-center text-red-500">
            <i class="fa-solid fa-envelope-open-text"></i>
          </div>
          <p class="text-xs text-zinc-300">کد ۶ رقمی ارسال‌شده به <span id="otpEmailDisplay" class="text-white font-semibold"></span> را وارد کنید:</p>
        </div>
        <div>
          <input type="text" id="otpCode" maxlength="6" required placeholder="123456" class="w-full text-center tracking-[0.5em] text-xl font-mono rounded-xl bg-zinc-800/60 border border-zinc-700/50 px-4 py-3 text-white placeholder-zinc-600 focus:border-red-500 focus:ring-1 focus:ring-red-500/50 focus:outline-none transition-all" />
        </div>

        <button type="submit" id="verifyOtpBtn" class="w-full py-3 mt-2 rounded-xl bg-gradient-to-r from-emerald-600 to-emerald-700 hover:from-emerald-500 hover:to-emerald-600 font-bold text-sm text-white shadow-lg active:scale-[0.98] transition-all flex items-center justify-center gap-2">
          <i class="fa-solid fa-circle-check text-xs"></i>
          تایید و فعال‌سازی حساب
        </button>
      </form>

    </div>
  </div>

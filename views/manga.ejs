        (function initDescriptionToggle() {
            const p = document.getElementById('dynamic-description');
            const btn = document.getElementById('descriptionToggleBtn');
            const text = document.getElementById('descriptionToggleText');
            if (!p || !btn) return;
            let expanded = false;
            const measure = () => {
                if (expanded) return;
                const over = p.scrollHeight > p.clientHeight + 4;
                p.classList.toggle('is-clamped', over);
                btn.classList.toggle('show', over);
            };
            requestAnimationFrame(measure);
            if (document.fonts && document.fonts.ready) document.fonts.ready.then(measure);
            window.addEventListener('resize', measure);
            btn.addEventListener('click', () => {
                expanded = !expanded;
                p.classList.toggle('expanded', expanded);
                p.style.maxHeight = expanded ? p.scrollHeight + 'px' : '';
                btn.classList.toggle('open', expanded);
                text.textContent = expanded ? 'نمایش کمتر' : 'توضیحات بیشتر';
                if (!expanded) document.getElementById('descriptionWrapper').scrollIntoView({ behavior: 'smooth', block: 'nearest' });

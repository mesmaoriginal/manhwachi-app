                این مانهوا اشتراکی است
            </div>
            
            <div class="space-y-4 lg:space-y-0 lg:grid lg:grid-cols-2 xl:grid-cols-3 lg:gap-4" id="episodeList">
                <%
                // رندر ۴ چپتر اول مستقیم در HTML برای خزش ربات گوگل
                var initial_episodes = episodes.slice(0, 4);
                initial_episodes.forEach(function(ep) {
                    var ep_num = ep.num;
                    var is_free = !!ep.free;
                    var ep_link = "/reader.html?slug=" + encodeURIComponent(slug) + "&ch=" + ep_num;
                %>
                <a href="<%= ep_link %>" data-free="<%= is_free ? '1' : '0' %>" data-num="<%= ep_num %>" class="flex items-center gap-4 p-4 rounded-2xl episode-card bg-surface-elevated">
                    <div class="w-20 h-14 bg-zinc-800 rounded-xl overflow-hidden relative shrink-0">

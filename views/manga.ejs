                        <p class="font-semibold text-white">چپتر <%= ep_num %></p>
                        <p class="text-xs text-text-muted mt-1"><%= ep.date || '' %></p>
                    </div>
                    <% if (is_free) { %>
                        <span class="text-sm font-bold text-green-500">رایگان</span>
                    <% } else { %>
                        <span class="block text-left text-amber-400 text-sm font-medium">اشتراکی</span>
                    <% } %>
                </a>
                <% }); %>
